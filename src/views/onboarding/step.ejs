<%- include('../partials/header') %>

<main class="container d-flex justify-content-center align-items-center min-vh-100 py-5">
    <div class="card shadow border-0 p-4" style="max-width: 600px; width: 100%; border-radius: 1rem;">
        
        <div class="progress mb-4" style="height: 8px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: <%= (step / 5) * 100 %>%" aria-valuenow="<%= (step / 5) * 100 %>" aria-valuemin="0" aria-valuemax="100"></div>
        </div>

        <% if (locals.error) { %>
            <div class="alert alert-danger" role="alert">
                <%= error %>
            </div>
        <% } %>

        <form action="/onboarding/<%= step %>" method="POST">
            
            <% if (step === 1) { %>
                <h2 class="text-center">Welcome to SkinCheck</h2>
                <p class="text-center mt-2 mb-4">
                    SkinCheck helps you monitor visual skin changes and receive personalized skincare insights.
                </p>
                <div class="alert alert-info border-start border-primary border-4" role="alert">
                    <strong>Important Note:</strong>
                    SkinCheck provides informational and visual analysis. It is not a medical diagnosis and does not replace a dermatologist or healthcare professional.
                </div>
                <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold mt-3">I Understand, Let's Go</button>

            <% } else if (step === 2) { %>
                <h2 class="text-center">Your Skincare Goals</h2>
                <p class="text-center text-muted mb-4">What do you want to achieve? (Select all that apply)</p>
                
                <div class="mb-4">
                    <div class="form-check mb-2">
                        <input type="checkbox" id="goal_acne" name="goals" class="form-check-input" value="Monitor acne-like visual changes" <%= profileData.goals && profileData.goals.includes('Monitor acne-like visual changes') ? 'checked' : '' %>>
                        <label for="goal_acne" class="form-check-label">Monitor acne-like visual changes</label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" id="goal_redness" name="goals" class="form-check-input" value="Monitor redness" <%= profileData.goals && profileData.goals.includes('Monitor redness') ? 'checked' : '' %>>
                        <label for="goal_redness" class="form-check-label">Monitor redness</label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" id="goal_texture" name="goals" class="form-check-input" value="Monitor skin texture" <%= profileData.goals && profileData.goals.includes('Monitor skin texture') ? 'checked' : '' %>>
                        <label for="goal_texture" class="form-check-label">Monitor skin texture</label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" id="goal_pigment" name="goals" class="form-check-input" value="Monitor hyperpigmentation appearance" <%= profileData.goals && profileData.goals.includes('Monitor hyperpigmentation appearance') ? 'checked' : '' %>>
                        <label for="goal_pigment" class="form-check-label">Monitor hyperpigmentation appearance</label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" id="goal_routine" name="goals" class="form-check-input" value="Build a skincare routine" <%= profileData.goals && profileData.goals.includes('Build a skincare routine') ? 'checked' : '' %>>
                        <label for="goal_routine" class="form-check-label">Build a skincare routine</label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" id="goal_sunscreen" name="goals" class="form-check-input" value="Check sunscreen application evenness" <%= profileData.goals && profileData.goals.includes('Check sunscreen application evenness') ? 'checked' : '' %>>
                        <label for="goal_sunscreen" class="form-check-label">Check sunscreen application evenness</label>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a href="/onboarding/<%= step - 1 %>" class="btn btn-outline-secondary w-100 rounded-pill">Back</a>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Continue</button>
                </div>

            <% } else if (step === 3) { %>
                <h2 class="text-center">Skincare Preferences</h2>
                <p class="text-center text-muted mb-4">Help us tailor insights to your needs.</p>

                <div class="mb-3">
                    <label for="skinConcerns" class="form-label">Main Skin Concerns (Optional)</label>
                    <input type="text" id="skinConcerns" name="skinConcerns" class="form-control" placeholder="e.g. Dryness, sensitivity" value="<%= profileData.preferences?.skinConcerns || '' %>">
                </div>

                <div class="mb-3">
                    <label for="ingredientPreferences" class="form-label">Ingredient Preferences (Optional)</label>
                    <input type="text" id="ingredientPreferences" name="ingredientPreferences" class="form-control" placeholder="e.g. Fragrance-free, vegan" value="<%= profileData.preferences?.ingredientPreferences || '' %>">
                </div>

                <div class="mb-3">
                    <label for="budgetPreference" class="form-label">Budget Preference (Optional)</label>
                    <select id="budgetPreference" name="budgetPreference" class="form-select">
                        <option value="">Select a budget range</option>
                        <option value="Drugstore" <%= profileData.preferences?.budgetPreference === 'Drugstore' ? 'selected' : '' %>>Drugstore / Affordable</option>
                        <option value="Mid-range" <%= profileData.preferences?.budgetPreference === 'Mid-range' ? 'selected' : '' %>>Mid-range</option>
                        <option value="High-end" <%= profileData.preferences?.budgetPreference === 'High-end' ? 'selected' : '' %>>High-end / Luxury</option>
                    </select>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a href="/onboarding/<%= step - 1 %>" class="btn btn-outline-secondary w-100 rounded-pill">Back</a>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Continue</button>
                </div>

            <% } else if (step === 4) { %>
                <h2 class="text-center">Current Products</h2>
                <p class="text-center text-muted mb-4">What products are you currently using? (Optional)</p>

                <div class="mb-3">
                    <label for="currentProducts" class="form-label">List your current skincare products (comma separated)</label>
                    <textarea id="currentProducts" name="currentProducts" class="form-control" rows="4" placeholder="e.g. Cetaphil Gentle Cleanser, COSRX Snail Mucin, La Roche-Posay Sunscreen"><%= profileData.products ? profileData.products.join(', ') : '' %></textarea>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a href="/onboarding/<%= step - 1 %>" class="btn btn-outline-secondary w-100 rounded-pill">Back</a>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Continue</button>
                </div>

            <% } else if (step === 5) { %>
                <h2 class="text-center">Privacy & Camera Consent</h2>
                <p class="text-center text-muted mb-4">We value your privacy and security.</p>

                <div class="card bg-light mb-4">
                    <div class="card-body">
                        <h4 class="card-title h6">How we use the camera</h4>
                        <ul class="small mb-0 ps-3 text-secondary">
                            <li class="mb-1">The browser will ask for camera permission when you start a scan.</li>
                            <li class="mb-1">SkinCheck <strong>does not</strong> access your camera without explicit browser permission.</li>
                            <li class="mb-1">Facial images and related data are sensitive. They are processed securely for visual analysis.</li>
                            <li>No images are shared with third parties for advertising purposes.</li>
                        </ul>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-check">
                        <input type="checkbox" id="cameraConsent" name="cameraConsent" class="form-check-input" required>
                        <label for="cameraConsent" class="form-check-label text-muted small">I understand that camera permissions will be required for face scanning and sunscreen checks, and I consent to this data being processed for visual analysis.</label>
                    </div>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <a href="/onboarding/<%= step - 1 %>" class="btn btn-outline-secondary w-100 rounded-pill">Back</a>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill">Complete Onboarding</button>
                </div>

            <% } %>

        </form>
    </div>
</main>

<%- include('../partials/footer') %>
