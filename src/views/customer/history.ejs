<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Progress Visual Kulit</h2>
        <% if (history.length > 0) { %>
            <a href="/app/scan" class="btn btn-primary rounded-pill fw-bold">Scan Baru</a>
        <% } %>
    </div>

    <!-- EMPTY STATE (0 SCANS) -->
    <% if (history.length === 0) { %>
        <div class="card shadow-sm border-0 text-center py-5">
            <div class="card-body">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-4" style="width: 80px; height: 80px;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
                </div>
                <h4 class="fw-bold">Belum Ada Data Scan</h4>
                <p class="text-muted mb-4 mx-auto" style="max-width: 500px;">
                    Untuk memantau progress visual kulit Anda, sistem memerlukan data scan wajah. Lakukan scan pertama Anda sekarang untuk membuat <strong>Baseline Scan</strong>.
                </p>
                <a href="/app/scan" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">Mulai Face Scan Pertama</a>
            </div>
        </div>
    <% } else { %>

        <!-- WARNING / DISCLAIMER -->
        <div class="alert alert-info border-start border-primary border-4 mb-4 small" role="alert">
            <strong>Informasi:</strong> Data di bawah ini menunjukkan tren estimasi visual berbasis AI. Ini bukan representasi atau rekam medis diagnostik.
        </div>

        <!-- 1 SCAN STATE -->
        <% if (history.length === 1) { %>
            <div class="alert alert-secondary mb-4" role="alert">
                <h6 class="alert-heading fw-bold">Grafik Tren Belum Tersedia</h6>
                <p class="mb-0 small">Anda baru memiliki 1 data scan (Baseline). Lakukan scan berikutnya dalam beberapa hari ke depan untuk melihat perbandingan dan grafik tren visual kulit Anda.</p>
            </div>
        <% } %>

        <!-- CHARTS (Shown only if > 1 scan) -->
        <% if (history.length > 1) { %>
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Tren Estimasi Visual</h5>
                    <select id="timeFilter" class="form-select form-select-sm w-auto rounded-pill">
                        <option value="7">7 Hari Terakhir</option>
                        <option value="30" selected>30 Hari Terakhir</option>
                        <option value="90">90 Hari Terakhir</option>
                        <option value="all">Semua Data</option>
                    </select>
                </div>
                <div class="card-body">
                    <div style="height: 300px; width: 100%;">
                        <canvas id="progressChart"></canvas>
                    </div>
                </div>
            </div>

            <!-- COMPARISON SECTION -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="fw-bold text-muted mb-3">VS Scan Sebelumnya</h6>
                            <% 
                                const current = history[0]; // Newest
                                const previous = history[1]; // Previous
                                const diff = current.overall_score - previous.overall_score;
                            %>
                            <div class="d-flex align-items-center gap-3">
                                <div class="display-5 fw-bold text-primary"><%= current.overall_score %></div>
                                <div>
                                    <div class="small fw-bold <%= diff > 0 ? 'text-success' : (diff < 0 ? 'text-danger' : 'text-muted') %>">
                                        <%- diff > 0 ? '↑ Relatif Meningkat' : (diff < 0 ? '↓ Relatif Menurun' : '→ Relatif Stabil') %>
                                    </div>
                                    <div class="small text-muted">vs <%= previous.overall_score %> (<%= new Date(previous.created_at).toLocaleDateString('id-ID', { month: 'short', day: 'numeric' }) %>)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body">
                            <h6 class="fw-bold text-muted mb-3">VS Baseline Scan</h6>
                            <% const diffBase = current.overall_score - baseline.overall_score; %>
                            <div class="d-flex align-items-center gap-3">
                                <div class="display-5 fw-bold text-primary"><%= current.overall_score %></div>
                                <div>
                                    <div class="small fw-bold <%= diffBase > 0 ? 'text-success' : (diffBase < 0 ? 'text-danger' : 'text-muted') %>">
                                        <%- diffBase > 0 ? '↑ Relatif Meningkat' : (diffBase < 0 ? '↓ Relatif Menurun' : '→ Relatif Stabil') %>
                                    </div>
                                    <div class="small text-muted">vs <%= baseline.overall_score %> (<%= new Date(baseline.created_at).toLocaleDateString('id-ID', { month: 'short', day: 'numeric' }) %>)</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>

        <!-- HISTORY LIST -->
        <h5 class="fw-bold mb-3 mt-5">Riwayat Scan</h5>
        <div class="row g-3">
            <% history.forEach((item, index) => { %>
                <div class="col-12">
                    <div class="card shadow-sm border-0 overflow-hidden">
                        <div class="row g-0 align-items-center">
                            <div class="col-auto bg-dark" style="width: 100px; height: 100px;">
                                <% if (item.scan) { %>
                                    <img src="/app/scan/image/<%= item.scan.id %>" class="w-100 h-100" style="object-fit: cover; transform: scaleX(-1);" alt="Scan">
                                <% } %>
                            </div>
                            <div class="col p-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h6 class="fw-bold mb-1">
                                            <%= new Date(item.created_at).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                            <% if (index === history.length - 1) { %>
                                                <span class="badge bg-secondary ms-2 small">Baseline</span>
                                            <% } %>
                                        </h6>
                                        <div class="text-muted small mb-2">
                                            <%= new Date(item.created_at).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %>
                                        </div>
                                        <div class="d-flex gap-3 small">
                                            <div><span class="text-danger fw-bold">J:</span> <%= item.acne_score %></div>
                                            <div><span class="text-warning fw-bold">M:</span> <%= item.redness_score %></div>
                                            <div><span class="text-info fw-bold">T:</span> <%= item.texture_score %></div>
                                            <div><span class="text-primary fw-bold">P:</span> <%= item.hyperpigmentation_score %></div>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fs-4 fw-bold text-primary mb-1"><%= item.overall_score %></div>
                                        <div class="d-flex gap-2 justify-content-end">
                                            <a href="/app/scan/result/<%= item.skin_scan_id %>" class="btn btn-sm btn-outline-primary rounded-pill">Detail</a>
                                            <button onclick="deleteScan('<%= item.skin_scan_id %>')" class="btn btn-sm btn-outline-danger rounded-pill" title="Hapus Scan">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

    <% } %>
</div>

<script>
    async function deleteScan(scanId) {
        let confirmed = false;
        if (window.showCenteredConfirm) {
            confirmed = await window.showCenteredConfirm({
                title: 'Hapus Data Scan',
                desc: 'Apakah Anda yakin ingin menghapus data scan ini? Data yang dihapus tidak dapat dikembalikan.',
                confirmText: 'Ya, Hapus',
                cancelText: 'Batal'
            });
        } else {
            confirmed = confirm('Apakah Anda yakin ingin menghapus data scan ini? Data yang dihapus tidak dapat dikembalikan.');
        }
        if (!confirmed) return;
            fetch(`/app/scan/${scanId}`, {
                method: 'DELETE',
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Gagal menghapus scan: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Terjadi kesalahan saat menghapus scan.');
            });
        }
    }
</script>

<% if (history.length > 1) { %>
<!-- Load Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // Inject History Data from Server
    // History is sorted newest first, so we reverse it for chronological charting (left to right)
    const rawData = <%- JSON.stringify(history) %>;
    const chronologicalData = [...rawData].reverse();

    let progressChart;

    function renderChart(days) {
        // Filter data by date
        let filteredData = chronologicalData;
        if (days !== 'all') {
            const cutoffDate = new Date();
            cutoffDate.setDate(cutoffDate.getDate() - parseInt(days));
            filteredData = chronologicalData.filter(d => new Date(d.created_at) >= cutoffDate);
        }

        // If no data in range, fallback to at least showing baseline
        if (filteredData.length === 0) {
            filteredData = [chronologicalData[0]]; // baseline
        }

        const labels = filteredData.map(d => {
            const date = new Date(d.created_at);
            return date.toLocaleDateString('id-ID', { month: 'short', day: 'numeric' });
        });

        const dataOverall = filteredData.map(d => d.overall_score);
        const dataAcne = filteredData.map(d => d.acne_score);
        const dataRedness = filteredData.map(d => d.redness_score);
        const dataTexture = filteredData.map(d => d.texture_score);
        const dataPigment = filteredData.map(d => d.hyperpigmentation_score);

        const ctx = document.getElementById('progressChart').getContext('2d');
        
        if (progressChart) {
            progressChart.destroy();
        }

        progressChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Skor Keseluruhan',
                        data: dataOverall,
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: true
                    },
                    {
                        label: 'Jerawat',
                        data: dataAcne,
                        borderColor: '#dc3545',
                        borderWidth: 2,
                        tension: 0.4,
                        hidden: true // Hidden by default to reduce clutter
                    },
                    {
                        label: 'Kemerahan',
                        data: dataRedness,
                        borderColor: '#ffc107',
                        borderWidth: 2,
                        tension: 0.4,
                        hidden: true
                    },
                    {
                        label: 'Tekstur',
                        data: dataTexture,
                        borderColor: '#0dcaf0',
                        borderWidth: 2,
                        tension: 0.4,
                        hidden: true
                    },
                    {
                        label: 'Hiperpigmentasi',
                        data: dataPigment,
                        borderColor: '#6f42c1',
                        borderWidth: 2,
                        tension: 0.4,
                        hidden: true
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            usePointStyle: true,
                            padding: 20
                        }
                    },
                    tooltip: {
                        mode: 'index',
                        intersect: false,
                    }
                },
                scales: {
                    y: {
                        min: 0,
                        max: 100,
                        grid: {
                            borderDash: [5, 5]
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                },
                interaction: {
                    mode: 'nearest',
                    axis: 'x',
                    intersect: false
                }
            }
        });
    }

    // Initialize Chart
    document.addEventListener('DOMContentLoaded', () => {
        renderChart(30); // Default to 30 days

        document.getElementById('timeFilter').addEventListener('change', (e) => {
            renderChart(e.target.value);
        });
    });
</script>
<% } %>
