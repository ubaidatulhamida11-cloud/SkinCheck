<style>
    .scan-container {
        max-width: 600px;
        margin: 40px auto;
        padding: 0 20px;
    }
    .warning-alert {
        background: rgba(253, 203, 110, 0.15);
        border-left: 4px solid #fdcb6e;
        padding: 16px 20px;
        border-radius: 8px;
        color: #b38422;
        margin-bottom: 24px;
        line-height: 1.5;
        font-size: 0.95rem;
    }
    .prep-list {
        list-style: none;
        padding: 0;
        margin: 0 0 30px 0;
    }
    .prep-list li {
        position: relative;
        padding-left: 32px;
        margin-bottom: 12px;
        color: var(--text-muted);
        line-height: 1.5;
        counter-increment: step-counter;
    }
    .prep-list li::before {
        content: counter(step-counter);
        position: absolute;
        left: 0;
        top: 0;
        width: 22px;
        height: 22px;
        background: var(--secondary);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        font-weight: bold;
    }
    .step-title {
        text-align: center;
        margin-bottom: 24px;
        font-size: 1.8rem;
    }
    .hidden {
        display: none !important;
    }
</style>

<div class="scan-container">
    <div class="glass-card" style="padding: 40px 30px;">
        
        <!-- STEP 1: PREPARATION -->
        <div id="step-preparation">
            <h3 class="step-title">Sunscreen Check</h3>
            <div class="warning-alert">
                <strong style="display: block; margin-bottom: 4px;">Perhatian</strong>
                Hasil menggunakan kamera RGB merupakan estimasi visual berbasis AI dan bukan pengukuran UV secara langsung.
            </div>
            
            <h5 style="margin-bottom: 16px; font-size: 1.1rem;">Langkah-langkah:</h5>
            <ol class="prep-list">
                <li>Aplikasikan sunscreen terlebih dahulu pada wajah Anda.</li>
                <li>Tunggu beberapa menit sesuai petunjuk penggunaan produk.</li>
                <li>Pastikan pencahayaan ruangan cukup terang.</li>
                <li>Posisikan wajah di dalam frame kamera.</li>
                <li>Jalankan pengecekan.</li>
            </ol>

            <button id="btn-start-camera" class="btn btn-secondary" style="width: 100%; padding: 14px; font-size: 1.1rem; border-radius: 50px; background: var(--secondary); color: white; border: none;">Mulai Pengecekan</button>
        </div>

        <%- include('../partials/camera_module', { 
            uploadUrl: '/app/sunscreen', 
            analyzeUrlPattern: '/app/sunscreen/ID_PLACEHOLDER/analyze',
            loadingMessage: 'Mengevaluasi Sunscreen...',
            loadingSubMessage: 'Menggunakan AI untuk mengestimasi visual coverage.'
        }) %>

    </div>
</div>
