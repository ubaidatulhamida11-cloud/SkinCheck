<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">Katalog Produk</h2>
    </div>

    <!-- CATEGORY FILTER -->
    <div class="mb-4 overflow-auto" style="white-space: nowrap; scrollbar-width: none;">
        <a href="/app/products" class="btn rounded-pill px-4 me-2 <%= !currentCategory ? 'btn-primary' : 'btn-outline-secondary' %>">Semua</a>
        <a href="/app/products?category=cleanser" class="btn rounded-pill px-4 me-2 <%= currentCategory === 'cleanser' ? 'btn-primary' : 'btn-outline-secondary' %>">Cleanser</a>
        <a href="/app/products?category=serum" class="btn rounded-pill px-4 me-2 <%= currentCategory === 'serum' ? 'btn-primary' : 'btn-outline-secondary' %>">Serum</a>
        <a href="/app/products?category=moisturizer" class="btn rounded-pill px-4 me-2 <%= currentCategory === 'moisturizer' ? 'btn-primary' : 'btn-outline-secondary' %>">Moisturizer</a>
        <a href="/app/products?category=sunscreen" class="btn rounded-pill px-4 me-2 <%= currentCategory === 'sunscreen' ? 'btn-primary' : 'btn-outline-secondary' %>">Sunscreen</a>
    </div>

    <!-- PRODUCT LIST -->
    <% if (products.length === 0) { %>
        <div class="text-center py-5">
            <h5 class="text-muted">Tidak ada produk ditemukan di kategori ini.</h5>
        </div>
    <% } else { %>
        <div class="row g-4">
            <% products.forEach(product => { %>
                <div class="col-md-6 col-lg-4">
                    <a href="/app/products/<%= product.id %>" class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm border-0 product-card transition-hover">
                            <!-- Placeholder Image -->
                            <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                            </div>
                            <div class="card-body">
                                <span class="badge bg-primary bg-opacity-10 text-primary mb-2"><%= product.category %></span>
                                <h6 class="text-muted small mb-1"><%= product.brand %></h6>
                                <h5 class="card-title fw-bold"><%= product.name %></h5>
                                <p class="card-text text-muted small text-truncate-2" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                    <%= product.description %>
                                </p>
                            </div>
                            <div class="card-footer bg-white border-0 pt-0">
                                <span class="text-primary fw-bold small">Lihat Detail &rarr;</span>
                            </div>
                        </div>
                    </a>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>
