<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/app/products" class="text-decoration-none">Katalog Produk</a></li>
            <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-md-5">
            <!-- Product Image Placeholder -->
            <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="height: 400px; width: 100%;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            </div>
        </div>
        
        <div class="col-md-7">
            <span class="badge bg-primary bg-opacity-10 text-primary mb-2 px-3 py-2 rounded-pill"><%= product.category %></span>
            <h6 class="text-muted fw-bold text-uppercase tracking-wider mb-1"><%= product.brand %></h6>
            <h2 class="fw-bold mb-3"><%= product.name %></h2>
            
            <p class="text-muted fs-5 mb-4">
                <%= product.description %>
            </p>

            <hr class="mb-4">

            <h5 class="fw-bold mb-3">Key Ingredients</h5>
            <div class="d-flex flex-wrap gap-2 mb-4">
                <% product.ingredients.forEach(ingredient => { %>
                    <span class="badge bg-light text-dark border px-3 py-2"><%= ingredient %></span>
                <% }) %>
            </div>

            <h5 class="fw-bold mb-3">Target Masalah Kulit (Skin Concern)</h5>
            <div class="d-flex flex-wrap gap-2 mb-4">
                <% product.skin_concern.forEach(concern => { %>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border-0 px-3 py-2"><%= concern %></span>
                <% }) %>
            </div>

            <h5 class="fw-bold mb-2">Panduan Penggunaan</h5>
            <div class="bg-primary bg-opacity-10 rounded p-4 text-dark mb-4">
                <p class="mb-0"><%= product.usage_guidance %></p>
            </div>

            <div class="alert alert-warning border-start border-warning border-4 small" role="alert">
                <strong>Disclaimer:</strong> Ini adalah produk kosmetik/OTC. Jika Anda mengalami iritasi atau reaksi negatif, segera hentikan penggunaan dan konsultasikan dengan dokter.
            </div>

        </div>
    </div>
</div>
