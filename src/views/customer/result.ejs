<style>
    .result-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 20px 0;
    }
    
    .status-badge {
        background: rgba(0, 184, 148, 0.15);
        color: var(--success);
        padding: 6px 16px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.9rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .warning-alert {
        background: rgba(253, 203, 110, 0.15);
        border-left: 4px solid #fdcb6e;
        padding: 20px;
        border-radius: 8px;
        display: flex;
        gap: 16px;
        margin-bottom: 30px;
        align-items: flex-start;
        color: #b38422;
        line-height: 1.5;
    }

    .scan-summary {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        align-items: center;
        margin-bottom: 30px;
    }

    .scan-thumbnail {
        width: 100px;
        height: 100px;
        border-radius: 16px;
        overflow: hidden;
        background: #000;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }

    .scan-thumbnail img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .scan-info {
        flex-grow: 1;
    }

    .scan-info h3 {
        margin-bottom: 8px;
        font-size: 1.5rem;
    }
    
    .scan-info p {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin-bottom: 4px;
    }

    .overall-score {
        background: rgba(255,255,255,0.6);
        padding: 20px 30px;
        border-radius: 16px;
        text-align: center;
        border: 1px solid rgba(255,255,255,0.8);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    }

    .overall-score .score-val {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--primary);
        line-height: 1;
        margin-bottom: 4px;
    }

    .indicators-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .indicator-card {
        padding: 24px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: transform 0.3s;
    }

    .indicator-card:hover {
        transform: translateY(-5px);
    }

    .indicator-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 16px;
    }

    .icon-acne { background: rgba(214, 48, 49, 0.1); color: #d63031; }
    .icon-redness { background: rgba(253, 203, 110, 0.1); color: #e1b12c; }
    .icon-texture { background: rgba(0, 206, 201, 0.1); color: #00cec9; }
    .icon-pigment { background: rgba(108, 92, 231, 0.1); color: #6c5ce7; }

    .indicator-card h4 {
        font-size: 1.1rem;
        margin-bottom: 12px;
    }

    .circular-score {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px auto;
        font-size: 1.6rem;
        font-weight: 800;
        position: relative;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .circular-score::before {
        content: '';
        position: absolute;
        top: 8px; left: 8px; right: 8px; bottom: 8px;
        background: var(--surface);
        border-radius: 50%;
        z-index: 1;
    }

    .circular-score span {
        position: relative;
        z-index: 2;
    }

    .indicator-card .desc {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 16px;
    }

    .trend-badge {
        font-size: 0.85rem;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 20px;
        background: #f0f2f5;
        width: 100%;
    }

    .trend-up { color: var(--success); background: rgba(0, 184, 148, 0.1); }
    .trend-down { color: var(--error); background: rgba(214, 48, 49, 0.1); }

    .conclusion-box {
        background: linear-gradient(135deg, rgba(255,255,255,0.8), rgba(255,255,255,0.4));
        padding: 24px;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,1);
        margin-bottom: 40px;
        display: flex;
        gap: 16px;
        align-items: flex-start;
    }

    .actions-flex {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: space-between;
        align-items: center;
    }
</style>

<div class="result-container">
    
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px;">
        <h2 style="font-size: 2.2rem; font-weight: 800; margin: 0;">Hasil Analisis Visual</h2>
        <span class="status-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Selesai
        </span>
    </div>

    <!-- DISCLAIMER -->
    <div class="warning-alert">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="flex-shrink: 0; margin-top: 2px;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div>
            <strong style="display: block; margin-bottom: 4px; font-size: 1.05rem;">Peringatan Medis</strong>
            Hasil di bawah ini merupakan indikasi visual yang dihasilkan oleh AI berdasarkan foto Anda. <strong>Ini bukan diagnosis medis</strong> dan tidak menggantikan konsultasi dengan dokter kulit profesional.
        </div>
    </div>

    <!-- SCAN SUMMARY -->
    <div class="glass-card scan-summary">
        <div class="scan-thumbnail">
            <img src="/app/scan/image/<%= scan.id %>" alt="Scan Thumbnail">
        </div>
        <div class="scan-info">
            <h3>Ringkasan Scan</h3>
            <p><strong>Waktu:</strong> <%= new Date(scan.created_at).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' }) %></p>
            <p><strong>Kualitas Gambar:</strong> <span style="color: var(--success); font-weight: 600;"><%= scan.image_quality_score %>/100</span> (Cukup Terang)</p>
            <% if (analysis.detected_condition) { %>
                <p><strong>Kondisi Dominan (AI):</strong> <span style="color: var(--primary); font-weight: bold; text-transform: capitalize;"><%= analysis.detected_condition.replace('_', ' ') %></span> <% if (analysis.confidence) { %>(<%= analysis.confidence %>%)<% } %></p>
            <% } %>
        </div>
        <div class="overall-score">
            <div class="score-val"><%= analysis.overall_score %></div>
            <div style="font-size: 0.9rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Skor Keseluruhan</div>
        </div>
    </div>

    <!-- VISUAL INDICATORS -->
    <h3 style="font-size: 1.5rem; margin-bottom: 20px;">Indikator Visual</h3>
    <div class="indicators-grid">
        
        <!-- Acne -->
        <div class="glass-card indicator-card">
            <h4 style="color: #d63031;">Jerawat</h4>
            <div class="circular-score" style="background: conic-gradient(#d63031 <%= analysis.acne_score %>%, #e1e5ee 0);">
                <span style="color: #d63031;"><%= analysis.acne_score %>%</span>
            </div>
            <p class="desc">Intensitas jerawat visual terdeteksi.</p>
            
            <% if (previousAnalysis) { %>
                <% const diffAcne = analysis.acne_score - previousAnalysis.acne_score; %>
                <div class="trend-badge <%= diffAcne > 0 ? 'trend-up' : (diffAcne < 0 ? 'trend-down' : '') %>">
                    <%- diffAcne > 0 ? '↑ Meningkat' : (diffAcne < 0 ? '↓ Menurun' : '→ Stabil') %>
                </div>
            <% } %>
        </div>

        <!-- Redness -->
        <div class="glass-card indicator-card">
            <h4 style="color: #e1b12c;">Kemerahan</h4>
            <div class="circular-score" style="background: conic-gradient(#e1b12c <%= analysis.redness_score %>%, #e1e5ee 0);">
                <span style="color: #e1b12c;"><%= analysis.redness_score %>%</span>
            </div>
            <p class="desc">Area kemerahan pada kulit.</p>
            
            <% if (previousAnalysis) { %>
                <% const diffRedness = analysis.redness_score - previousAnalysis.redness_score; %>
                <div class="trend-badge <%= diffRedness > 0 ? 'trend-up' : (diffRedness < 0 ? 'trend-down' : '') %>">
                    <%- diffRedness > 0 ? '↑ Meningkat' : (diffRedness < 0 ? '↓ Menurun' : '→ Stabil') %>
                </div>
            <% } %>
        </div>

        <!-- Texture -->
        <div class="glass-card indicator-card">
            <h4 style="color: #00cec9;">Tekstur</h4>
            <div class="circular-score" style="background: conic-gradient(#00cec9 <%= analysis.texture_score %>%, #e1e5ee 0);">
                <span style="color: #00cec9;"><%= analysis.texture_score %>%</span>
            </div>
            <p class="desc">Tingkat kehalusan permukaan wajah.</p>
            
            <% if (previousAnalysis) { %>
                <% const diffTexture = analysis.texture_score - previousAnalysis.texture_score; %>
                <div class="trend-badge <%= diffTexture > 0 ? 'trend-up' : (diffTexture < 0 ? 'trend-down' : '') %>">
                    <%- diffTexture > 0 ? '↑ Meningkat' : (diffTexture < 0 ? '↓ Menurun' : '→ Stabil') %>
                </div>
            <% } %>
        </div>

        <!-- Pigmentation -->
        <div class="glass-card indicator-card">
            <h4 style="color: #6c5ce7;">Flek / Pigmen</h4>
            <div class="circular-score" style="background: conic-gradient(#6c5ce7 <%= analysis.hyperpigmentation_score %>%, #e1e5ee 0);">
                <span style="color: #6c5ce7;"><%= analysis.hyperpigmentation_score %>%</span>
            </div>
            <p class="desc">Deteksi area hiperpigmentasi.</p>
            
            <% if (previousAnalysis) { %>
                <% const diffPigment = analysis.hyperpigmentation_score - previousAnalysis.hyperpigmentation_score; %>
                <div class="trend-badge <%= diffPigment > 0 ? 'trend-up' : (diffPigment < 0 ? 'trend-down' : '') %>">
                    <%- diffPigment > 0 ? '↑ Meningkat' : (diffPigment < 0 ? '↓ Menurun' : '→ Stabil') %>
                </div>
            <% } %>
        </div>

    </div>

    <!-- OVERALL SUMMARY -->
    <div class="conclusion-box">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary" style="flex-shrink: 0; color: var(--primary); margin-top: 4px;">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
        <div>
            <h4 style="font-size: 1.2rem; margin-bottom: 8px;">Kesimpulan</h4>
            <p style="color: var(--text-muted); margin: 0; line-height: 1.6;">
                Beberapa indikator visual pada wajah Anda telah diestimasi. Hasil ini dapat Anda bandingkan dengan scan sebelumnya untuk membantu memantau perubahan kondisi visual kulit secara lebih objektif. Anda juga dapat berkonsultasi dengan asisten AI kami mengenai rutinitas yang cocok.
            </p>
        </div>
    </div>

    <!-- ACTIONS -->
    <div class="actions-flex">
        <div style="display: flex; gap: 16px;">
            <a href="/app/dashboard" class="btn btn-secondary" style="padding: 12px 24px;">Kembali ke Dashboard</a>
            <a href="/app/history" class="btn btn-secondary" style="padding: 12px 24px; border-color: #e1e5ee; color: var(--text-muted);">Lihat Riwayat</a>
        </div>
        
        <a href="/app/assistant?contextType=skin_scan&contextId=<%= scan.id %>" class="btn btn-primary" style="padding: 12px 28px; display: inline-flex; align-items: center; gap: 10px; font-size: 1.05rem;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            Tanya AI tentang hasil ini
        </a>
    </div>

</div>
