<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.title ? title + ' | ' : '' %>SkinCheck Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/theme.js"></script>
    <script>
        // Pre-apply sidebar state to prevent layout flashing
        try {
            if (localStorage.getItem('skincheck_sidebar_collapsed') === '1' && window.innerWidth > 992) {
                document.documentElement.classList.add('preload-sidebar-collapsed');
            }
        } catch (e) {}
    </script>
</head>
<body>
    <header class="customer-header">
        <div class="customer-header-inner">
            <div style="display: flex; align-items: center; gap: 10px;">
                <button type="button" class="sidebar-toggle-btn" id="sidebar-toggle" title="Sembunyikan / Tampilkan Sidebar" aria-label="Toggle Sidebar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="9" y1="3" x2="9" y2="21"></line>
                        <path d="M14 9l3 3-3 3"></path>
                    </svg>
                </button>
                <a href="/app/dashboard" class="logo">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L2 7L12 12L22 7L12 2Z" fill="url(#paint0_linear)"/>
                        <path d="M2 17L12 22L22 17" stroke="url(#paint1_linear)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M2 12L12 17L22 12" stroke="url(#paint2_linear)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <defs>
                            <linearGradient id="paint0_linear" x1="2" y1="7" x2="22" y2="7" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#6C5CE7"/>
                                <stop offset="1" stop-color="#00CEC9"/>
                            </linearGradient>
                            <linearGradient id="paint1_linear" x1="2" y1="19.5" x2="22" y2="19.5" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#6C5CE7"/>
                                <stop offset="1" stop-color="#00CEC9"/>
                            </linearGradient>
                            <linearGradient id="paint2_linear" x1="2" y1="14.5" x2="22" y2="14.5" gradientUnits="userSpaceOnUse">
                                <stop stop-color="#6C5CE7"/>
                                <stop offset="1" stop-color="#00CEC9"/>
                            </linearGradient>
                        </defs>
                    </svg>
                    SkinCheck
                </a>
            </div>

            <div style="display: flex; align-items: center; gap: 14px;">
                <button type="button" class="theme-toggle-btn" title="Ganti Tema Gelap/Terang">
                    🌙 <span>Gelap</span>
                </button>

                <% if (locals.user && locals.user.role === 'admin') { %>
                    <a href="/admin/dashboard" class="btn btn-primary" style="padding: 6px 14px; font-size: 0.85rem; background: linear-gradient(135deg, #e17055, #d63031); border: none; border-radius: 20px;">
                        🛡️ Admin Panel
                    </a>
                <% } %>

                <div style="display: flex; align-items: center; gap: 10px; padding-left: 6px; border-left: 1px solid var(--border-color);">
                    <div style="width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, var(--primary), var(--secondary)); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem;">
                        <%= locals.user ? locals.user.name.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div style="line-height: 1.2; text-align: left;" class="d-none d-sm-block">
                        <div style="font-weight: 700; font-size: 0.88rem; color: var(--text-main);">
                            <%= locals.user ? locals.user.name.split(' ')[0] : 'User' %>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">
                            <%= locals.user && locals.user.role === 'admin' ? 'Administrator' : 'Customer' %>
                        </div>
                    </div>
                </div>

                <a href="/auth/logout" class="btn btn-secondary" style="padding: 6px 16px; font-size: 0.85rem; border-radius: 20px;">
                    Logout
                </a>
            </div>
        </div>
    </header>

    <div class="customer-container" id="customer-container">
        <!-- Mobile Backdrop -->
        <div class="sidebar-overlay" id="sidebar-overlay"></div>

        <!-- Left Docked Sidebar -->
        <aside class="customer-sidebar" id="customer-sidebar">
            <div class="sidebar-header-box">
                <span class="sidebar-header-title">Menu Navigasi</span>
                <button type="button" class="sidebar-close-btn" id="sidebar-close-btn" title="Sembunyikan Sidebar" aria-label="Sembunyikan Sidebar">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
            </div>

            <nav class="customer-sidebar-nav">
                <a href="/app/dashboard" class="customer-nav-item <%= locals.page === 'dashboard' ? 'active' : '' %>">
                    <span class="nav-icon">📊</span>
                    <span>Dashboard</span>
                </a>
                <a href="/app/scan" class="customer-nav-item <%= (locals.page === 'scan' || locals.page === 'result' || locals.page === 'result_pending') ? 'active' : '' %>">
                    <span class="nav-icon">📷</span>
                    <span>Face Scan</span>
                </a>
                <a href="/app/sunscreen" class="customer-nav-item <%= (locals.page === 'sunscreen' || locals.page === 'sunscreen_result') ? 'active' : '' %>">
                    <span class="nav-icon">☀️</span>
                    <span>Sunscreen Check</span>
                </a>
                <a href="/app/history" class="customer-nav-item <%= locals.page === 'history' ? 'active' : '' %>">
                    <span class="nav-icon">🕒</span>
                    <span>Scan History</span>
                </a>
                <a href="/app/assistant" class="customer-nav-item <%= locals.page === 'assistant' ? 'active' : '' %>" style="justify-content: space-between;">
                    <span style="display: flex; align-items: center; gap: 12px;">
                        <span class="nav-icon">🤖</span>
                        <span>Chatbot AI</span>
                    </span>
                    <span class="badge-ai" style="background: linear-gradient(135deg, #6c5ce7, #a29bfe); color: white; font-size: 0.65rem; font-weight: 800; padding: 2px 7px; border-radius: 10px; text-transform: uppercase;">AI</span>
                </a>
                <a href="/app/products" class="customer-nav-item <%= (locals.page === 'products' || locals.page === 'product_detail') ? 'active' : '' %>">
                    <span class="nav-icon">🛍️</span>
                    <span>Katalog Produk</span>
                </a>
                <a href="/app/profile" class="customer-nav-item <%= locals.page === 'profile' ? 'active' : '' %>">
                    <span class="nav-icon">👤</span>
                    <span>Profil & Akun</span>
                </a>
            </nav>

            <div style="margin-top: auto; padding: 14px; background: rgba(108, 92, 231, 0.06); border-radius: 12px; border: 1px solid rgba(108, 92, 231, 0.15); font-size: 0.78rem; color: var(--text-muted); line-height: 1.4;">
                <div style="font-weight: 700; color: var(--primary); margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                    <span>💡</span> Catatan Edukatif
                </div>
                <div>Hasil analisis visual adalah estimasi informatif, bukan diagnosis medis klinis.</div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="customer-content">
            <%- include(locals.page) %>
        </main>
    </div>

    <% if (locals.page === 'assistant') { %>
        <style>#chatbot-widget { display: none !important; }</style>
    <% } %>
    <%- include('../partials/chatbot-widget') %>

    <script>
        (function() {
            const toggleBtn = document.getElementById('sidebar-toggle');
            const closeBtn = document.getElementById('sidebar-close-btn');
            const container = document.getElementById('customer-container');
            const sidebar = document.getElementById('customer-sidebar');
            const overlay = document.getElementById('sidebar-overlay');

            // Apply pre-loaded collapsed state immediately if requested
            if (document.documentElement.classList.contains('preload-sidebar-collapsed') && container) {
                container.classList.add('sidebar-collapsed');
                if (toggleBtn) toggleBtn.setAttribute('title', 'Tampilkan Sidebar');
            } else if (localStorage.getItem('skincheck_sidebar_collapsed') === '1' && window.innerWidth > 992 && container) {
                container.classList.add('sidebar-collapsed');
                if (toggleBtn) toggleBtn.setAttribute('title', 'Tampilkan Sidebar');
            }

            function toggleSidebar() {
                if (window.innerWidth <= 992) {
                    // Mobile behavior: off-canvas drawer
                    if (sidebar) sidebar.classList.toggle('open');
                    if (overlay) overlay.classList.toggle('active');
                } else {
                    // Desktop behavior: collapse / expand
                    if (container) {
                        container.classList.toggle('sidebar-collapsed');
                        const isCollapsed = container.classList.contains('sidebar-collapsed');
                        localStorage.setItem('skincheck_sidebar_collapsed', isCollapsed ? '1' : '0');
                        if (toggleBtn) {
                            toggleBtn.setAttribute('title', isCollapsed ? 'Tampilkan Sidebar' : 'Sembunyikan Sidebar');
                        }
                    }
                }
            }

            function closeSidebar() {
                if (window.innerWidth <= 992) {
                    if (sidebar) sidebar.classList.remove('open');
                    if (overlay) overlay.classList.remove('active');
                } else {
                    if (container) {
                        container.classList.add('sidebar-collapsed');
                        localStorage.setItem('skincheck_sidebar_collapsed', '1');
                        if (toggleBtn) toggleBtn.setAttribute('title', 'Tampilkan Sidebar');
                    }
                }
            }

            if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
            if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
            if (overlay) overlay.addEventListener('click', () => {
                if (sidebar) sidebar.classList.remove('open');
                if (overlay) overlay.classList.remove('active');
            });
        })();
    </script>
</body>
</html>
