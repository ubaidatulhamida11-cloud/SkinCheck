<script>
(function() {
    // Avoid double initialization
    if (window._skincheckChatbotInitialized) return;
    window._skincheckChatbotInitialized = true;

    // Scoped storage key per user
    const CHAT_USER_ID = '<%= (locals.user && locals.user.id) ? locals.user.id : "guest" %>';
    const CHAT_STORAGE_KEY = 'skincheck_chat_history_v2_' + CHAT_USER_ID;

    // Global Centered Modal Helper (Confirmation)
    window.showCenteredConfirm = function(options = {}) {
        return new Promise((resolve) => {
            const modal = document.getElementById('chatbot-confirm-modal');
            const iconEl = document.getElementById('chatbot-modal-icon') || modal?.querySelector('.chatbot-modal-badge-icon');
            const titleEl = document.getElementById('chatbot-modal-title');
            const descEl = document.getElementById('chatbot-modal-desc');
            const confirmBtn = document.getElementById('chatbot-modal-confirm');
            const cancelBtn = document.getElementById('chatbot-modal-cancel');

            if (!modal) {
                resolve(true);
                return;
            }

            if (iconEl) {
                iconEl.textContent = options.icon || '🗑️';
                iconEl.style.background = options.iconBg || 'rgba(239, 68, 68, 0.12)';
                iconEl.style.color = options.iconColor || '#ef4444';
            }

            if (options.title) titleEl.textContent = options.title;
            if (options.desc) descEl.textContent = options.desc;

            if (cancelBtn) {
                cancelBtn.style.display = '';
                cancelBtn.textContent = options.cancelText || 'Batal';
            }

            if (confirmBtn) {
                confirmBtn.textContent = options.confirmText || 'Ya, Hapus';
                confirmBtn.className = 'chatbot-modal-btn ' + (options.confirmClass || 'btn-danger');
                confirmBtn.style.background = options.confirmBg || '#ef4444';
                confirmBtn.style.borderColor = options.confirmBg || '#ef4444';
                confirmBtn.style.color = '#ffffff';
            }

            modal.style.display = 'flex';

            function cleanup(result) {
                modal.style.display = 'none';
                confirmBtn.removeEventListener('click', onConfirm);
                if (cancelBtn) cancelBtn.removeEventListener('click', onCancel);
                resolve(result);
            }

            function onConfirm() { cleanup(true); }
            function onCancel() { cleanup(false); }

            confirmBtn.addEventListener('click', onConfirm);
            if (cancelBtn) cancelBtn.addEventListener('click', onCancel);
        });
    };

    // Global Centered Modal Helper (Alert / Notifikasi Tengah Layar)
    window.showCenteredAlert = function(options = {}) {
        return new Promise((resolve) => {
            const modal = document.getElementById('chatbot-confirm-modal');
            const iconEl = document.getElementById('chatbot-modal-icon') || modal?.querySelector('.chatbot-modal-badge-icon');
            const titleEl = document.getElementById('chatbot-modal-title');
            const descEl = document.getElementById('chatbot-modal-desc');
            const confirmBtn = document.getElementById('chatbot-modal-confirm');
            const cancelBtn = document.getElementById('chatbot-modal-cancel');

            if (!modal) {
                alert(options.desc || options.title || 'Notifikasi');
                resolve(true);
                return;
            }

            const type = options.type || (options.isError ? 'error' : (options.isEdit ? 'edit' : 'success'));
            if (iconEl) {
                if (options.icon) {
                    iconEl.textContent = options.icon;
                } else if (type === 'edit') {
                    iconEl.textContent = '✏️';
                } else if (type === 'success') {
                    iconEl.textContent = '✅';
                } else if (type === 'error') {
                    iconEl.textContent = '⚠️';
                } else {
                    iconEl.textContent = 'ℹ️';
                }

                if (type === 'edit') {
                    iconEl.style.background = 'rgba(108, 92, 231, 0.14)';
                    iconEl.style.color = '#6C5CE7';
                } else if (type === 'success') {
                    iconEl.style.background = 'rgba(0, 184, 148, 0.14)';
                    iconEl.style.color = '#00b894';
                } else if (type === 'error') {
                    iconEl.style.background = 'rgba(239, 68, 68, 0.14)';
                    iconEl.style.color = '#ef4444';
                } else {
                    iconEl.style.background = 'rgba(9, 132, 227, 0.14)';
                    iconEl.style.color = '#0984e3';
                }
            }

            if (options.title) titleEl.textContent = options.title;
            if (options.desc) descEl.textContent = options.desc;

            // In Alert mode: hide Cancel button
            if (cancelBtn) cancelBtn.style.display = 'none';

            if (confirmBtn) {
                confirmBtn.textContent = options.btnText || options.confirmText || 'Selesai';
                if (type === 'edit' || type === 'success') {
                    confirmBtn.className = 'chatbot-modal-btn btn-primary';
                    confirmBtn.style.background = '#6C5CE7';
                    confirmBtn.style.borderColor = '#6C5CE7';
                    confirmBtn.style.color = '#ffffff';
                } else if (type === 'error') {
                    confirmBtn.className = 'chatbot-modal-btn btn-danger';
                    confirmBtn.style.background = '#ef4444';
                    confirmBtn.style.borderColor = '#ef4444';
                    confirmBtn.style.color = '#ffffff';
                } else {
                    confirmBtn.className = 'chatbot-modal-btn btn-primary';
                    confirmBtn.style.background = '#0984e3';
                    confirmBtn.style.borderColor = '#0984e3';
                    confirmBtn.style.color = '#ffffff';
                }
            }

            modal.style.display = 'flex';

            function cleanup() {
                modal.style.display = 'none';
                if (cancelBtn) cancelBtn.style.display = '';
                if (confirmBtn) {
                    confirmBtn.style.background = '';
                    confirmBtn.style.borderColor = '';
                    confirmBtn.style.color = '';
                    confirmBtn.removeEventListener('click', onOk);
                }
                resolve(true);
            }

            function onOk() { cleanup(); }
            if (confirmBtn) confirmBtn.addEventListener('click', onOk);
        });
    };

    document.addEventListener('DOMContentLoaded', initChatbotWidget);
    if (document.readyState === 'interactive' || document.readyState === 'complete') {
        initChatbotWidget();
    }

    function initChatbotWidget() {
        const toggleBtn = document.getElementById('chatbot-toggle');
        const closeBtn = document.getElementById('chatbot-close-btn');
        const clearBtn = document.getElementById('chatbot-clear-btn');
        const chatWindow = document.getElementById('chatbot-window');
        const inputField = document.getElementById('chatbot-input');
        const sendBtn = document.getElementById('chatbot-send');
        const messagesContainer = document.getElementById('chatbot-messages');
        const form = document.getElementById('chatbot-form');

        if (!toggleBtn || !chatWindow || !messagesContainer) return;

        const iconOpen = toggleBtn.querySelector('.icon-open');
        const iconClose = toggleBtn.querySelector('.icon-close');

        function toggleChat(show) {
            const isCurrentlyOpen = chatWindow.style.display === 'flex';
            const shouldOpen = typeof show === 'boolean' ? show : !isCurrentlyOpen;

            if (shouldOpen) {
                chatWindow.style.display = 'flex';
                if (iconOpen) iconOpen.style.display = 'none';
                if (iconClose) iconClose.style.display = 'flex';
                toggleBtn.title = 'Tutup Chat';
                setTimeout(() => {
                    if (inputField) inputField.focus();
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }, 150);
            } else {
                chatWindow.style.display = 'none';
                if (iconOpen) iconOpen.style.display = 'flex';
                if (iconClose) iconClose.style.display = 'none';
                toggleBtn.title = 'Buka Chatbot AI';
            }
        }

        toggleBtn.addEventListener('click', () => toggleChat());
        if (closeBtn) closeBtn.addEventListener('click', () => toggleChat(false));

        // Format clock time
        function formatClock(date = new Date()) {
            const h = String(date.getHours()).padStart(2, '0');
            const m = String(date.getMinutes()).padStart(2, '0');
            return `${h}:${m}`;
        }

        // Clean text utility to strip asterisks completely
        function cleanNoAsterisk(text) {
            if (!text) return '';
            return text
                .replace(/\*\*(.*?)\*\*/g, '$1')
                .replace(/\*(.*?)\*/g, '$1')
                .replace(/\*/g, '')
                .trim();
        }

        // Local storage helpers
        function getStoredHistory() {
            try {
                const raw = localStorage.getItem(CHAT_STORAGE_KEY);
                return raw ? JSON.parse(raw) : [];
            } catch (err) {
                console.error('Error reading chatbot history', err);
                return [];
            }
        }

        function setStoredHistory(list) {
            try {
                localStorage.setItem(CHAT_STORAGE_KEY, JSON.stringify(list));
            } catch (err) {
                console.error('Error saving chatbot history', err);
            }
        }

        // Render Empty State (Default Greeting + Interactive Starter Suggestions)
        function renderEmptyState() {
            messagesContainer.innerHTML = `
                <div class="chatbot-msg-item ai-msg" id="chatbot-default-welcome">
                    <div class="chatbot-bubble">
                        Halo! Saya asisten AI SkinCheck. Ada yang bisa saya bantu terkait fitur aplikasi, rekomendasi produk, atau perawatan kulit hari ini?
                    </div>
                </div>

                <div id="chatbot-starter-box" class="chatbot-starter-box">
                    <div class="chatbot-starter-card">
                        <div style="font-weight: 700; color: #6c5ce7; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
                            <span>💡</span> Pusat Bantuan Interaktif
                        </div>
                        <div>SkinCheck AI terhubung langsung dengan sistem database. Pilih saran pertanyaan di bawah atau ketik langsung pertanyaan Anda:</div>
                    </div>

                    <div class="chatbot-chips-title">⚡ Rekomendasi Pertanyaan:</div>
                    <div class="chatbot-chips-list">
                        <button type="button" class="chatbot-chip" data-question="Berapa banyak pengguna yang ada di sistem database?">
                            <span>📊</span> Data Pengguna
                        </button>
                        <button type="button" class="chatbot-chip" data-question="Apa saja rekomendasi sunscreen untuk kulit berminyak?">
                            <span>🧴</span> Rekomendasi Sunscreen
                        </button>
                        <button type="button" class="chatbot-chip" data-question="Apa saja fitur yang tersedia di aplikasi SkinCheck?">
                            <span>✨</span> Fitur Aplikasi
                        </button>
                        <button type="button" class="chatbot-chip" data-question="Bagaimana cara kerja cek sunscreen dan skor proteksi?">
                            <span>☀️</span> Cek Sunscreen
                        </button>
                        <button type="button" class="chatbot-chip" data-question="Bagaimana cara melihat profil dan riwayat scan saya?">
                            <span>👤</span> Profil & Riwayat
                        </button>
                        <button type="button" class="chatbot-chip" data-question="Bagaimana panduan foto scan wajah yang tepat?">
                            <span>📷</span> Tips Face Scan
                        </button>
                    </div>
                </div>
            `;
            wireChipButtons();
        }

        // Connect starter chips to auto-send
        function wireChipButtons() {
            const chips = messagesContainer.querySelectorAll('.chatbot-chip');
            chips.forEach(chip => {
                chip.addEventListener('click', (e) => {
                    e.preventDefault();
                    const q = chip.getAttribute('data-question');
                    if (q && inputField) {
                        inputField.value = q;
                        sendMessage();
                    }
                });
            });
        }

        // Render full persistent chat history
        function loadChatHistory() {
            const history = getStoredHistory();
            messagesContainer.innerHTML = '';

            if (history && history.length > 0) {
                // History Badge Header
                const badge = document.createElement('div');
                badge.className = 'chatbot-history-badge';
                badge.innerHTML = '🕒 Riwayat Obrolan Tersimpan';
                messagesContainer.appendChild(badge);

                // Populate all previous saved messages
                history.forEach(item => {
                    createMessageElement(item.text, item.isUser, true, item.id, item.time);
                });
            } else {
                renderEmptyState();
            }

            setTimeout(() => {
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }, 50);
        }

        // Create Message DOM element with time and delete action
        function createMessageElement(text, isUser = false, canDelete = true, msgId = null, timeStr = null) {
            const cleanText = cleanNoAsterisk(text);
            const id = msgId || ('msg_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6));
            const time = timeStr || formatClock();

            const msgWrapper = document.createElement('div');
            msgWrapper.id = id;
            msgWrapper.className = `chatbot-msg-item ${isUser ? 'user-msg' : 'ai-msg'}`;

            const bubble = document.createElement('div');
            bubble.className = 'chatbot-bubble';
            bubble.textContent = cleanText;
            msgWrapper.appendChild(bubble);

            const metaRow = document.createElement('div');
            metaRow.className = 'chatbot-msg-meta';

            const timeEl = document.createElement('span');
            timeEl.className = 'chatbot-msg-time';
            timeEl.textContent = time;
            metaRow.appendChild(timeEl);

            if (canDelete) {
                const delBtn = document.createElement('button');
                delBtn.type = 'button';
                delBtn.className = 'chatbot-del-btn';
                delBtn.innerHTML = '🗑️ Hapus';
                delBtn.title = 'Hapus pesan ini dari riwayat';
                delBtn.onclick = async () => {
                    const confirmed = await window.showCenteredConfirm({
                        title: 'Hapus Pesan',
                        desc: 'Apakah Anda yakin ingin menghapus pesan ini dari riwayat percakapan?',
                        confirmText: 'Ya, Hapus',
                        cancelText: 'Batal'
                    });
                    if (confirmed) {
                        msgWrapper.style.opacity = '0';
                        msgWrapper.style.transform = 'scale(0.9)';
                        setTimeout(() => {
                            msgWrapper.remove();
                            // Update localStorage
                            let currentHistory = getStoredHistory().filter(m => m.id !== id);
                            setStoredHistory(currentHistory);
                            if (currentHistory.length === 0) {
                                renderEmptyState();
                            }
                        }, 200);
                    }
                };
                metaRow.appendChild(delBtn);
            }

            msgWrapper.appendChild(metaRow);
            messagesContainer.appendChild(msgWrapper);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

            return { id, text: cleanText, isUser, time };
        }

        // Clear Chat History using the CENTERED confirmation modal
        if (clearBtn) {
            clearBtn.addEventListener('click', async () => {
                const confirmed = await window.showCenteredConfirm({
                    title: 'Hapus Riwayat Percakapan',
                    desc: 'Apakah Anda yakin ingin menghapus seluruh riwayat percakapan chatbot ini? Riwayat obrolan akan dibersihkan dari tampilan dan penyimpanan.',
                    confirmText: 'Ya, Hapus',
                    cancelText: 'Batal'
                });

                if (confirmed) {
                    localStorage.removeItem(CHAT_STORAGE_KEY);
                    renderEmptyState();
                    try {
                        const clearEndpoint = window.location.pathname.startsWith('/app') 
                            ? '/app/api/chatbot-widget/clear' 
                            : (window.location.pathname.startsWith('/admin') ? '/admin/api/chatbot-widget/clear' : '/api/chatbot-widget/clear');
                        await fetch(clearEndpoint, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({})
                        });
                    } catch (err) {
                        console.error('Failed to clear widget history on server', err);
                    }
                }
            });
        }

        // Send Message
        async function sendMessage() {
            const text = inputField.value.trim();
            if (!text) return;

            // Remove starter box if present
            const starterBox = document.getElementById('chatbot-starter-box');
            if (starterBox) starterBox.remove();
            const defaultWelcome = document.getElementById('chatbot-default-welcome');
            if (defaultWelcome) defaultWelcome.remove();

            // Append user message & persist
            const userMsgObj = createMessageElement(text, true, true);
            const currentHistory = getStoredHistory();
            currentHistory.push(userMsgObj);
            setStoredHistory(currentHistory);

            inputField.value = '';
            inputField.disabled = true;
            sendBtn.disabled = true;

            // Loading bubble
            const loadingDiv = document.createElement('div');
            loadingDiv.id = 'chatbot-loading';
            loadingDiv.className = 'chatbot-msg-item ai-msg';
            loadingDiv.innerHTML = '<div class="chatbot-bubble" style="opacity: 0.6; font-style: italic;">Sedang mengetik...</div>';
            messagesContainer.appendChild(loadingDiv);
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

            try {
                const endpoint = window.location.pathname.startsWith('/app') 
                    ? '/app/api/chatbot-widget' 
                    : (window.location.pathname.startsWith('/admin') ? '/admin/api/chatbot-widget' : '/api/chatbot-widget');
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                });
                const data = await response.json();

                document.getElementById('chatbot-loading')?.remove();

                let replyText = 'Maaf, terjadi kendala saat memproses jawaban. Silakan coba lagi.';
                if (data.success && data.reply) {
                    replyText = data.reply;
                }

                // Append AI reply & persist
                const aiMsgObj = createMessageElement(replyText, false, true);
                const updatedHistory = getStoredHistory();
                updatedHistory.push(aiMsgObj);
                setStoredHistory(updatedHistory);
            } catch (err) {
                document.getElementById('chatbot-loading')?.remove();
                const errorMsgObj = createMessageElement('Koneksi terputus. Silakan periksa jaringan Anda.', false, true);
                const updatedHistory = getStoredHistory();
                updatedHistory.push(errorMsgObj);
                setStoredHistory(updatedHistory);
            } finally {
                inputField.disabled = false;
                sendBtn.disabled = false;
                inputField.focus();
                messagesContainer.scrollTop = messagesContainer.scrollHeight;
            }
        }

        if (form) {
            form.addEventListener('submit', (e) => {
                e.preventDefault();
                sendMessage();
            });
        }
        if (sendBtn) {
            sendBtn.addEventListener('click', (e) => {
                e.preventDefault();
                sendMessage();
            });
        }
        if (inputField) {
            inputField.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    sendMessage();
                }
            });
        }

        // Initialize Chat History from Storage
        loadChatHistory();
    }
})();
</script>
