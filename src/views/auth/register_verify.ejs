<%- include('../partials/header') %>

<main class="container d-flex justify-content-center align-items-center min-vh-100 py-5">
    <div class="card shadow border-0 p-4" style="max-width: 480px; width: 100%; border-radius: 1.25rem; background: var(--surface); color: var(--text-main);">
        <div class="text-center mb-3">
            <div style="font-size: 2.8rem; margin-bottom: 8px;">💬</div>
            <h2 class="fw-bold mb-1" style="color: var(--text-main);">Verifikasi Nomor WhatsApp</h2>
            <p class="text-muted small mb-0">Langkah terakhir untuk mengaktifkan akun SkinCheck Anda</p>
        </div>

        <% if (locals.error) { %>
            <div id="reg-verify-alert" class="alert alert-danger py-2 px-3 small rounded-3" role="alert">
                <%= error %>
            </div>
        <% } else { %>
            <div id="reg-verify-alert" class="alert d-none py-2 px-3 small rounded-3" role="alert"></div>
        <% } %>

        <div class="p-3 mb-3 rounded-3 text-center" style="background: var(--surface-light); border: 1px solid var(--border-color);">
            <div class="text-muted small mb-1">Kode 6-digit dikirimkan via WhatsApp ke:</div>
            <div class="d-flex justify-content-center align-items-center gap-2">
                <strong class="fs-5" style="color: var(--text-main);"><%= maskedPhone %></strong>
                <a href="/auth/register" class="btn btn-link btn-sm p-0 text-decoration-none" title="Ubah data">✏️ Ubah</a>
            </div>
        </div>

        <form action="/auth/register/verify" method="POST" id="form-register-verify">
            <input type="hidden" name="otp" id="final-otp-input" value="">

            <!-- 6-digit OTP Inputs -->
            <div class="d-flex justify-content-between gap-2 mb-3" id="otp-input-container">
                <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-1" inputmode="numeric" autocomplete="one-time-code" autofocus>
                <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-2" inputmode="numeric">
                <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-3" inputmode="numeric">
                <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-4" inputmode="numeric">
                <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-5" inputmode="numeric">
                <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-6" inputmode="numeric">
            </div>

            <!-- Countdown Timer & Resend Button -->
            <div class="d-flex justify-content-between align-items-center mb-4 small">
                <span class="text-muted">
                    ⏳ Berlaku: <strong id="reg-expiry-seconds">05:00</strong>
                </span>
                <button type="button" id="reg-btn-resend" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" onclick="resendRegistrationOtp()" <%= locals.resendCooldown > 0 ? 'disabled' : '' %>>
                    Kirim Ulang (<span id="reg-cooldown-seconds"><%= locals.resendCooldown || 60 %>s</span>)
                </button>
            </div>

            <!-- Submit Button -->
            <button type="submit" id="reg-btn-submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm">
                <span id="reg-btn-spinner" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                <span id="reg-btn-text">Verifikasi & Buat Akun 🎉</span>
            </button>
        </form>

        <p class="text-center mt-4 mb-0" style="font-size: 0.9rem;">
            Salah memasukkan nomor? <a href="/auth/register" style="font-weight: 600;">Kembali ke Pendaftaran</a>
        </p>
    </div>
</main>

<style>
.otp-digit {
    width: 48px;
    height: 56px;
    border-radius: 0.75rem;
    border: 2px solid var(--border-color);
    background: var(--surface);
    color: var(--text-main);
    transition: all 0.15s ease;
}
.otp-digit:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.2);
    outline: none;
}
</style>

<script>
let cooldownRemaining = <%= locals.resendCooldown || 60 %>;
let expiryRemaining = 300;
let cooldownInterval = null;
let expiryInterval = null;

document.addEventListener('DOMContentLoaded', () => {
    setupOtpDigitInputs();
    startCooldownTimer(cooldownRemaining);
    startExpiryTimer(expiryRemaining);

    document.getElementById('form-register-verify').onsubmit = function(e) {
        const code = getEnteredOtp();
        if (code.length !== 6) {
            e.preventDefault();
            showAlert('Silakan masukkan 6 digit kode OTP secara lengkap.');
            return false;
        }
        document.getElementById('final-otp-input').value = code;
        document.getElementById('reg-btn-submit').disabled = true;
        document.getElementById('reg-btn-spinner').classList.remove('d-none');
        document.getElementById('reg-btn-text').textContent = 'Memverifikasi...';
    };
});

function showAlert(msg, type = 'danger') {
    const alertBox = document.getElementById('reg-verify-alert');
    alertBox.className = `alert alert-${type} py-2 px-3 small rounded-3`;
    alertBox.textContent = msg;
    alertBox.classList.remove('d-none');
}

function getEnteredOtp() {
    let code = '';
    for (let i = 1; i <= 6; i++) {
        code += (document.getElementById(`otp-${i}`).value || '').trim();
    }
    return code;
}

function setupOtpDigitInputs() {
    const inputs = document.querySelectorAll('.otp-digit');
    inputs.forEach((input, index) => {
        input.oninput = (e) => {
            const val = e.target.value.replace(/\D/g, '');
            input.value = val ? val[val.length - 1] : '';
            if (val && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
            if (getEnteredOtp().length === 6) {
                document.getElementById('final-otp-input').value = getEnteredOtp();
            }
        };

        input.onkeydown = (e) => {
            if (e.key === 'Backspace' && !input.value && index > 0) {
                inputs[index - 1].focus();
            }
        };

        input.onpaste = (e) => {
            e.preventDefault();
            const pasteData = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
            if (pasteData) {
                const digits = pasteData.slice(0, 6).split('');
                digits.forEach((digit, idx) => {
                    if (inputs[idx]) inputs[idx].value = digit;
                });
                const nextIdx = Math.min(digits.length, inputs.length - 1);
                inputs[nextIdx].focus();
                if (digits.length >= 6) {
                    document.getElementById('final-otp-input').value = getEnteredOtp();
                }
            }
        };
    });

    setTimeout(() => {
        const first = document.getElementById('otp-1');
        if (first) first.focus();
    }, 150);
}

function startCooldownTimer(seconds) {
    clearInterval(cooldownInterval);
    cooldownRemaining = seconds;
    const btn = document.getElementById('reg-btn-resend');
    if (cooldownRemaining > 0) {
        btn.disabled = true;
    }

    cooldownInterval = setInterval(() => {
        cooldownRemaining--;
        if (cooldownRemaining <= 0) {
            clearInterval(cooldownInterval);
            btn.disabled = false;
            btn.textContent = 'Kirim Ulang Kode';
        } else {
            btn.innerHTML = `Kirim Ulang (<span id="reg-cooldown-seconds">${cooldownRemaining}s</span>)`;
        }
    }, 1000);
}

function startExpiryTimer(seconds) {
    clearInterval(expiryInterval);
    expiryRemaining = seconds;
    const display = document.getElementById('reg-expiry-seconds');

    function update() {
        const m = Math.floor(expiryRemaining / 60).toString().padStart(2, '0');
        const s = (expiryRemaining % 60).toString().padStart(2, '0');
        display.textContent = `${m}:${s}`;
    }

    update();
    expiryInterval = setInterval(() => {
        expiryRemaining--;
        if (expiryRemaining <= 0) {
            clearInterval(expiryInterval);
            display.textContent = 'Kedaluwarsa';
            showAlert('Kode OTP verifikasi telah kedaluwarsa. Silakan minta kode baru.', 'danger');
        } else {
            update();
        }
    }, 1000);
}

async function resendRegistrationOtp() {
    if (cooldownRemaining > 0) return;
    const btn = document.getElementById('reg-btn-resend');
    btn.disabled = true;
    btn.textContent = 'Mengirim...';

    try {
        const response = await fetch('/auth/register/resend-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await response.json();

        if (data.success) {
            showAlert('Kode OTP baru telah dikirimkan ke WhatsApp Anda.', 'success');
            startCooldownTimer(data.resendCooldownSeconds || 60);
            startExpiryTimer(300);
            for (let i = 1; i <= 6; i++) {
                document.getElementById(`otp-${i}`).value = '';
            }
            document.getElementById('otp-1').focus();
        } else {
            showAlert(data.message || 'Gagal mengirim ulang OTP.', 'danger');
            btn.disabled = false;
            btn.textContent = 'Kirim Ulang Kode';
        }
    } catch (err) {
        console.error(err);
        showAlert('Gangguan koneksi.', 'danger');
        btn.disabled = false;
        btn.textContent = 'Kirim Ulang Kode';
    }
}
</script>

<%- include('../partials/footer') %>
