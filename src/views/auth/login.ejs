<%- include('../partials/header') %>

<main class="container d-flex justify-content-center align-items-center min-vh-100 py-5">
    <div class="card shadow border-0 p-4" style="max-width: 480px; width: 100%; border-radius: 1.25rem; background: var(--surface); color: var(--text-main);">
        <h2 class="text-center fw-bold mb-1" style="color: var(--text-main);">Selamat Datang</h2>
        <p class="text-center text-muted mb-4" style="font-size: 0.95rem;">Masuk ke akun SkinCheck Anda</p>
        
        <% if (locals.error) { %>
            <div class="alert alert-danger" role="alert">
                <%= error %>
            </div>
        <% } %>

        <!-- Authentication Method Tabs -->
        <div class="d-flex p-1 mb-4 rounded-pill" style="background: rgba(108, 92, 231, 0.08); border: 1px solid var(--border-color);">
            <button type="button" id="tab-btn-password" class="btn w-50 rounded-pill py-2 fw-semibold active-auth-tab" onclick="switchAuthTab('password')">
                🔑 Kata Sandi
            </button>
            <button type="button" id="tab-btn-whatsapp" class="btn w-50 rounded-pill py-2 fw-semibold text-muted" onclick="switchAuthTab('whatsapp')">
                <span style="color: #25D366;">💬</span> WhatsApp OTP
            </button>
        </div>

        <!-- 1. Password Login Form (Preserved Original) -->
        <div id="section-password-login">
            <form action="/auth/login" method="POST">
                <div class="mb-3">
                    <label for="email" class="form-label fw-semibold" style="font-size: 0.9rem;">Email Address</label>
                    <input type="email" id="email" name="email" class="form-control py-2" required placeholder="you@example.com" style="border-radius: 0.75rem;">
                </div>
                
                <div class="mb-3">
                    <label for="password" class="form-label fw-semibold" style="font-size: 0.9rem;">Password</label>
                    <div class="input-group">
                        <input type="password" id="password" name="password" class="form-control py-2" required placeholder="••••••••" style="border-radius: 0.75rem 0 0 0.75rem;">
                        <button type="button" class="btn btn-outline-secondary d-flex align-items-center justify-content-center px-3 toggle-password-btn" data-target="password" style="border-radius: 0 0.75rem 0.75rem 0; border-color: var(--border-color); color: var(--text-muted); background: var(--surface);" title="Lihat Password" aria-label="Lihat password">
                            <svg class="eye-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg class="eye-off-icon d-none" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                </div>
                
                <div class="form-check mb-4">
                    <input type="checkbox" id="remember" name="remember" class="form-check-input">
                    <label for="remember" class="form-check-label text-muted small">Remember me on this device</label>
                </div>
                
                <button type="submit" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm">
                    Sign In
                </button>
            </form>
        </div>

        <!-- 2. WhatsApp OTP Login Flow -->
        <div id="section-whatsapp-login" style="display: none;">
            <!-- Alert notification box -->
            <div id="wa-alert" class="alert d-none mb-3 py-2 px-3 small rounded-3" role="alert"></div>

            <!-- Step 1: Input Phone Number -->
            <div id="wa-step-phone">
                <div class="p-3 mb-3 rounded-3" style="background: rgba(37, 211, 102, 0.08); border: 1px solid rgba(37, 211, 102, 0.25);">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span style="font-size: 1.25rem;">📱</span>
                        <strong style="color: #128C7E; font-size: 0.95rem;">Login Cepat via WhatsApp</strong>
                    </div>
                    <p class="mb-0 text-muted small" style="line-height: 1.4;">
                        Masukkan nomor WhatsApp Anda untuk menerima kode OTP 6-digit tanpa perlu menghafal kata sandi.
                    </p>
                </div>

                <div class="mb-3">
                    <label for="wa-phone-input" class="form-label fw-semibold" style="font-size: 0.9rem;">Nomor WhatsApp</label>
                    <div class="input-group">
                        <span class="input-group-text fw-bold" style="background: var(--surface-light); border-radius: 0.75rem 0 0 0.75rem;">🇮🇩 +62</span>
                        <input type="tel" id="wa-phone-input" class="form-control py-2" placeholder="812-3456-7890" style="border-radius: 0 0.75rem 0.75rem 0;">
                    </div>
                    <small class="text-muted" style="font-size: 0.8rem;">Contoh: 081234567890 atau 81234567890</small>
                </div>

                <button type="button" id="wa-btn-request" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm mt-2" onclick="requestWhatsAppOtp()">
                    <span id="wa-request-spinner" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                    <span id="wa-request-btn-text">Kirim Kode OTP</span>
                </button>
            </div>

            <!-- Step 2: Input OTP Verification -->
            <div id="wa-step-verify" style="display: none;">
                <div class="text-center mb-3">
                    <p class="mb-1 text-muted small">Kode verifikasi 6-digit dikirimkan ke:</p>
                    <div class="d-flex justify-content-center align-items-center gap-2">
                        <strong id="wa-display-phone" class="fw-bold" style="font-size: 1.05rem; color: var(--text-main);">+62 812-****-7890</strong>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" onclick="goBackToPhoneStep()" title="Ganti nomor">
                            ✏️ Ubah
                        </button>
                    </div>
                </div>

                <!-- 6-digit OTP Inputs -->
                <div class="d-flex justify-content-between gap-2 mb-3" id="otp-input-container">
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-1" inputmode="numeric" autocomplete="one-time-code">
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-2" inputmode="numeric">
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-3" inputmode="numeric">
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-4" inputmode="numeric">
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-5" inputmode="numeric">
                    <input type="text" maxlength="1" class="form-control text-center fw-bold fs-4 otp-digit" id="otp-6" inputmode="numeric">
                </div>

                <!-- Countdown & Resend -->
                <div class="d-flex justify-content-between align-items-center mb-3 small">
                    <span id="wa-expiry-timer" class="text-muted">
                        ⏳ Berlaku: <strong id="wa-expiry-seconds">05:00</strong>
                    </span>
                    <button type="button" id="wa-btn-resend" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" onclick="resendWhatsAppOtp()" disabled>
                        Kirim Ulang (<span id="wa-cooldown-seconds">60s</span>)
                    </button>
                </div>

                <!-- Verify Button -->
                <button type="button" id="wa-btn-verify" class="btn btn-primary w-100 py-2 rounded-pill fw-semibold shadow-sm" onclick="verifyWhatsAppOtp()">
                    <span id="wa-verify-spinner" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                    <span id="wa-verify-btn-text">Verifikasi & Masuk</span>
                </button>
            </div>
        </div>
        
        <p class="text-center mt-4 mb-0" style="font-size: 0.95rem;">
            Belum punya akun? <a href="/auth/register" style="font-weight: 600;">Daftar di sini</a>
        </p>
    </div>
</main>

<style>
.active-auth-tab {
    background: var(--surface) !important;
    color: var(--primary) !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.otp-digit {
    width: 48px;
    height: 56px;
    border-radius: 0.75rem;
    border: 2px solid var(--border-color);
    background: var(--surface);
    color: var(--text-main);
    transition: all 0.15s ease;
}
.otp-digit:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.2);
    outline: none;
}
</style>

<script>
// State management
let currentChallengeId = null;
let currentRawPhone = '';
let cooldownTimerInterval = null;
let expiryTimerInterval = null;
let cooldownRemaining = 0;
let expiryRemaining = 300;

function switchAuthTab(mode) {
    const pwdTab = document.getElementById('tab-btn-password');
    const waTab = document.getElementById('tab-btn-whatsapp');
    const pwdSec = document.getElementById('section-password-login');
    const waSec = document.getElementById('section-whatsapp-login');

    if (mode === 'password') {
        pwdTab.classList.add('active-auth-tab');
        pwdTab.classList.remove('text-muted');
        waTab.classList.remove('active-auth-tab');
        waTab.classList.add('text-muted');
        pwdSec.style.display = 'block';
        waSec.style.display = 'none';
    } else {
        waTab.classList.add('active-auth-tab');
        waTab.classList.remove('text-muted');
        pwdTab.classList.remove('active-auth-tab');
        pwdTab.classList.add('text-muted');
        pwdSec.style.display = 'none';
        waSec.style.display = 'block';
    }
}

function showWaAlert(message, type = 'danger') {
    const alertBox = document.getElementById('wa-alert');
    alertBox.className = `alert alert-${type} mb-3 py-2 px-3 small rounded-3`;
    alertBox.textContent = message;
    alertBox.classList.remove('d-none');
}

function hideWaAlert() {
    const alertBox = document.getElementById('wa-alert');
    alertBox.classList.add('d-none');
}

function goBackToPhoneStep() {
    clearInterval(cooldownTimerInterval);
    clearInterval(expiryTimerInterval);
    document.getElementById('wa-step-phone').style.display = 'block';
    document.getElementById('wa-step-verify').style.display = 'none';
    hideWaAlert();
}

async function requestWhatsAppOtp() {
    const phoneInput = document.getElementById('wa-phone-input');
    const rawPhone = phoneInput.value.trim();

    if (!rawPhone) {
        showWaAlert('Silakan masukkan nomor telepon WhatsApp Anda.');
        phoneInput.focus();
        return;
    }

    hideWaAlert();
    setLoadingState('request', true);

    try {
        const response = await fetch('/api/auth/whatsapp/request-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone: rawPhone, purpose: 'login' })
        });

        const data = await response.json();

        if (data.success) {
            currentChallengeId = data.challengeId;
            currentRawPhone = rawPhone;

            document.getElementById('wa-display-phone').textContent = data.maskedPhone || rawPhone;
            document.getElementById('wa-step-phone').style.display = 'none';
            document.getElementById('wa-step-verify').style.display = 'block';

            // Start Timers
            startCooldownTimer(data.resendCooldownSeconds || 60);
            startExpiryTimer(data.expiresInSeconds || 300);

            showWaAlert(data.message, 'success');
            setupOtpInputs();
        } else {
            showWaAlert(data.message || 'Gagal mengirim OTP.');
        }
    } catch (err) {
        console.error(err);
        showWaAlert('Terjadi kesalahan koneksi ke server. Silakan coba lagi.');
    } finally {
        setLoadingState('request', false);
    }
}

async function resendWhatsAppOtp() {
    if (cooldownRemaining > 0) return;
    hideWaAlert();

    const resendBtn = document.getElementById('wa-btn-resend');
    resendBtn.disabled = true;
    resendBtn.textContent = 'Mengirim...';

    try {
        const response = await fetch('/api/auth/whatsapp/resend-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                challengeId: currentChallengeId,
                phone: currentRawPhone,
                purpose: 'login'
            })
        });

        const data = await response.json();

        if (data.success) {
            currentChallengeId = data.challengeId;
            showWaAlert('Kode verifikasi baru telah dikirimkan via WhatsApp.', 'success');
            startCooldownTimer(data.resendCooldownSeconds || 60);
            startExpiryTimer(data.expiresInSeconds || 300);
            clearOtpDigits();
        } else {
            showWaAlert(data.message || 'Gagal mengirim ulang OTP.');
            resendBtn.disabled = false;
            resendBtn.textContent = 'Kirim Ulang Kode';
        }
    } catch (err) {
        console.error(err);
        showWaAlert('Gagal menghubungi server.');
        resendBtn.disabled = false;
        resendBtn.textContent = 'Kirim Ulang Kode';
    }
}

async function verifyWhatsAppOtp() {
    const otpCode = getEnteredOtp();

    if (otpCode.length !== 6) {
        showWaAlert('Silakan masukkan 6 digit kode OTP secara lengkap.');
        return;
    }

    hideWaAlert();
    setLoadingState('verify', true);

    try {
        const response = await fetch('/api/auth/whatsapp/verify-otp', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                challengeId: currentChallengeId,
                otp: otpCode,
                purpose: 'login',
                phone: currentRawPhone
            })
        });

        const data = await response.json();

        if (data.success) {
            showWaAlert('Login berhasil! Mengalihkan ke dashboard...', 'success');
            setTimeout(() => {
                window.location.href = data.redirectUrl || '/app/dashboard';
            }, 800);
        } else {
            showWaAlert(data.message || 'Kode verifikasi salah.');
            if (data.error === 'USER_NOT_FOUND') {
                // If phone is valid but not linked, offer registration
                showWaAlert(data.message + ' Klik link di bawah untuk mendaftar akun baru.', 'warning');
            }
        }
    } catch (err) {
        console.error(err);
        showWaAlert('Terjadi kesalahan saat memverifikasi. Silakan coba lagi.');
    } finally {
        setLoadingState('verify', false);
    }
}

function startCooldownTimer(seconds) {
    clearInterval(cooldownTimerInterval);
    cooldownRemaining = seconds;
    const resendBtn = document.getElementById('wa-btn-resend');
    resendBtn.disabled = true;

    cooldownTimerInterval = setInterval(() => {
        cooldownRemaining--;
        if (cooldownRemaining <= 0) {
            clearInterval(cooldownTimerInterval);
            resendBtn.disabled = false;
            resendBtn.textContent = 'Kirim Ulang Kode';
        } else {
            resendBtn.innerHTML = `Kirim Ulang (<span id="wa-cooldown-seconds">${cooldownRemaining}s</span>)`;
        }
    }, 1000);
}

function startExpiryTimer(seconds) {
    clearInterval(expiryTimerInterval);
    expiryRemaining = seconds;
    const expiryDisplay = document.getElementById('wa-expiry-seconds');

    function updateExpiryText() {
        const m = Math.floor(expiryRemaining / 60).toString().padStart(2, '0');
        const s = (expiryRemaining % 60).toString().padStart(2, '0');
        expiryDisplay.textContent = `${m}:${s}`;
    }

    updateExpiryText();
    expiryTimerInterval = setInterval(() => {
        expiryRemaining--;
        if (expiryRemaining <= 0) {
            clearInterval(expiryTimerInterval);
            expiryDisplay.textContent = 'Kedaluwarsa';
            showWaAlert('Kode verifikasi telah kedaluwarsa. Silakan klik kirim ulang.', 'danger');
        } else {
            updateExpiryText();
        }
    }, 1000);
}

function setLoadingState(action, isLoading) {
    if (action === 'request') {
        const btn = document.getElementById('wa-btn-request');
        const spinner = document.getElementById('wa-request-spinner');
        const txt = document.getElementById('wa-request-btn-text');
        btn.disabled = isLoading;
        if (isLoading) {
            spinner.classList.remove('d-none');
            txt.textContent = 'Memproses...';
        } else {
            spinner.classList.add('d-none');
            txt.textContent = 'Kirim Kode OTP';
        }
    } else if (action === 'verify') {
        const btn = document.getElementById('wa-btn-verify');
        const spinner = document.getElementById('wa-verify-spinner');
        const txt = document.getElementById('wa-verify-btn-text');
        btn.disabled = isLoading;
        if (isLoading) {
            spinner.classList.remove('d-none');
            txt.textContent = 'Memverifikasi...';
        } else {
            spinner.classList.add('d-none');
            txt.textContent = 'Verifikasi & Masuk';
        }
    }
}

function getEnteredOtp() {
    let code = '';
    for (let i = 1; i <= 6; i++) {
        code += (document.getElementById(`otp-${i}`).value || '').trim();
    }
    return code;
}

function clearOtpDigits() {
    for (let i = 1; i <= 6; i++) {
        document.getElementById(`otp-${i}`).value = '';
    }
    const firstInput = document.getElementById('otp-1');
    if (firstInput) firstInput.focus();
}

function setupOtpInputs() {
    const inputs = document.querySelectorAll('.otp-digit');
    inputs.forEach((input, index) => {
        input.value = '';
        input.oninput = (e) => {
            const val = e.target.value.replace(/\D/g, '');
            input.value = val ? val[val.length - 1] : '';
            if (val && index < inputs.length - 1) {
                inputs[index + 1].focus();
            }
            if (getEnteredOtp().length === 6) {
                verifyWhatsAppOtp();
            }
        };

        input.onkeydown = (e) => {
            if (e.key === 'Backspace' && !input.value && index > 0) {
                inputs[index - 1].focus();
            }
        };

        input.onpaste = (e) => {
            e.preventDefault();
            const pasteData = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
            if (pasteData) {
                const digits = pasteData.slice(0, 6).split('');
                digits.forEach((digit, idx) => {
                    if (inputs[idx]) inputs[idx].value = digit;
                });
                const nextIdx = Math.min(digits.length, inputs.length - 1);
                inputs[nextIdx].focus();
                if (digits.length >= 6) {
                    verifyWhatsAppOtp();
                }
            }
        };
    });

    setTimeout(() => {
        const first = document.getElementById('otp-1');
        if (first) first.focus();
    }, 150);
}

document.querySelectorAll('.toggle-password-btn').forEach(button => {
    button.addEventListener('click', function() {
        const targetId = this.getAttribute('data-target');
        const input = document.getElementById(targetId);
        if (!input) return;

        const eyeIcon = this.querySelector('.eye-icon');
        const eyeOffIcon = this.querySelector('.eye-off-icon');

        if (input.type === 'password') {
            input.type = 'text';
            eyeIcon.classList.add('d-none');
            eyeOffIcon.classList.remove('d-none');
            this.setAttribute('title', 'Sembunyikan Password');
            this.setAttribute('aria-label', 'Sembunyikan password');
        } else {
            input.type = 'password';
            eyeIcon.classList.remove('d-none');
            eyeOffIcon.classList.add('d-none');
            this.setAttribute('title', 'Lihat Password');
            this.setAttribute('aria-label', 'Lihat password');
        }
    });
});
</script>

<%- include('../partials/footer') %>
