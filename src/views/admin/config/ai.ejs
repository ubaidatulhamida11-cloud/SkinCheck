<!-- TAB 2: MODEL AI & PARAMETER -->
<!-- ============================================================ -->
<div id="ai-section-models" class="ai-tab-content d-none">
    <div class="stat-card" style="margin-bottom: 24px;">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 16px; color: var(--text-main, #1e293b);">
            Daftar Model AI Multi-Vendor yang Didukung
        </h3>
        <p style="color: var(--text-muted, #64748b); font-size: 0.88rem; margin-bottom: 20px;">
            Atur model default, alokasi token output maksimum, tingkat kreativitas (temperature), dan batas waktu timeout request.
        </p>

        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th style="width: 40px;">Default</th>
                        <th>Model ID & Nama</th>
                        <th>Provider</th>
                        <th>Max Output Token</th>
                        <th>Temperature</th>
                        <th>Timeout (ms)</th>
                        <th>Retry</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="models-table-body">
                    <% (ai.models || []).forEach((model, idx) => { %>
                        <% 
                            let prov = model.provider;
                            if (!prov) {
                                if (model.id.startsWith('gemini')) prov = 'gemini';
                                else if (model.id.startsWith('gpt')) prov = 'openai';
                                else if (model.id.startsWith('claude')) prov = 'claude';
                                else if (model.id.startsWith('llama') || model.id.startsWith('deepseek')) prov = 'custom_ai';
                                else prov = 'local_knowledge';
                            }
                            let provBadgeColor = '#6C5CE7';
                            let provBadgeBg = 'rgba(108, 92, 231, 0.12)';
                            if (prov === 'openai') { provBadgeColor = '#10a37f'; provBadgeBg = 'rgba(16, 163, 127, 0.12)'; }
                            else if (prov === 'custom_ai') { provBadgeColor = '#e67e22'; provBadgeBg = 'rgba(230, 126, 34, 0.12)'; }
                            else if (prov === 'claude') { provBadgeColor = '#d97706'; provBadgeBg = 'rgba(217, 119, 6, 0.12)'; }
                            else if (prov === 'local_knowledge') { provBadgeColor = '#00b894'; provBadgeBg = 'rgba(0, 184, 148, 0.12)'; }
                        %>
                        <tr data-model-id="<%= model.id %>" data-model-provider="<%= prov %>" data-model-name="<%= model.name || model.id %>" data-model-desc="<%= model.description || '' %>">
                            <td class="text-center">
                                <input type="radio" name="default_model_radio" value="<%= model.id %>" <%= model.is_default ? 'checked' : '' %> onchange="onDefaultModelChanged('<%= model.id %>')">
                            </td>
                            <td>
                                <strong style="color: var(--text-main, #1e293b);"><%= model.name || model.id %></strong>
                                <div style="font-size: 0.78rem; font-family: monospace; color: #64748b;"><%= model.id %></div>
                                <div style="font-size: 0.75rem; color: #94a3b8;"><%= model.description || '' %></div>
                            </td>
                            <td>
                                <span class="badge" style="background: <%= provBadgeBg %>; color: <%= provBadgeColor %>; font-size: 0.75rem; font-weight: 700;">
                                    <%= prov.toUpperCase() %>
                                </span>
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm model-max-tokens" value="<%= model.max_tokens || 1000 %>" min="100" max="8192" style="width: 90px;">
                            </td>
                            <td>
                                <input type="number" step="0.1" class="form-control form-control-sm model-temperature" value="<%= model.temperature !== undefined ? model.temperature : 0.7 %>" min="0" max="1" style="width: 75px;">
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm model-timeout" value="<%= model.timeout_ms || 10000 %>" min="1000" max="60000" style="width: 95px;">
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm model-retry" value="<%= model.retry_count !== undefined ? model.retry_count : 1 %>" min="0" max="5" style="width: 60px;">
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input model-active-switch" type="checkbox" <%= model.is_active ? 'checked' : '' %>>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- TAB 3: PENGATURAN AI ASSISTANT -->
<!-- ============================================================ -->
<div id="ai-section-assistant" class="ai-tab-content d-none">
    <div class="stat-card" style="margin-bottom: 24px; max-width: 850px;">
        <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 16px; color: var(--text-main, #1e293b);">
            Persona & Perilaku AI Assistant
        </h3>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label for="assistant-name" class="form-label fw-semibold" style="font-size: 0.88rem;">Nama AI Assistant</label>
                <input type="text" id="assistant-name" class="form-control" value="<%= (ai.assistant && ai.assistant.name) || 'SkinCheck AI Assistant' %>" style="border-radius: 8px;">
            </div>
            <div class="col-md-6">
                <label for="assistant-lang" class="form-label fw-semibold" style="font-size: 0.88rem;">Bahasa Respons Utama</label>
                <select id="assistant-lang" class="form-select" style="border-radius: 8px;">
                    <option value="id" <%= (ai.assistant && ai.assistant.language === 'id') ? 'selected' : '' %>>Bahasa Indonesia (Standar)</option>
                    <option value="en" <%= (ai.assistant && ai.assistant.language === 'en') ? 'selected' : '' %>>English</option>
                </select>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label for="assistant-style" class="form-label fw-semibold" style="font-size: 0.88rem;">Gaya Komunikasi</label>
                <select id="assistant-style" class="form-select" style="border-radius: 8px;">
                    <option value="Ramah & Profesional" <%= (ai.assistant && ai.assistant.communication_style === 'Ramah & Profesional') ? 'selected' : '' %>>Ramah & Profesional (Rekomendasi)</option>
                    <option value="Edukasi & Ringkas" <%= (ai.assistant && ai.assistant.communication_style === 'Edukasi & Ringkas') ? 'selected' : '' %>>Edukasi & Ringkas</option>
                    <option value="Formal & Santun" <%= (ai.assistant && ai.assistant.communication_style === 'Formal & Santun') ? 'selected' : '' %>>Formal & Santun</option>
                </select>
            </div>
            <div class="col-md-6">
                <label for="assistant-max-length" class="form-label fw-semibold" style="font-size: 0.88rem;">Maksimum Panjang Respons (Kata)</label>
                <input type="number" id="assistant-max-length" class="form-control" value="<%= (ai.assistant && ai.assistant.max_response_length) || 150 %>" min="50" max="600" style="border-radius: 8px;">
            </div>
        </div>

        <div class="mb-4">
            <label for="assistant-instruction" class="form-label fw-semibold d-flex justify-content-between" style="font-size: 0.88rem;">
                <span>System Instruction (Instruksi Dasar AI)</span>
                <span class="text-danger small fw-normal">*Aturan keamanan medis wajib dipertahankan</span>
            </label>
            <textarea id="assistant-instruction" class="form-control" rows="5" style="border-radius: 8px; font-size: 0.88rem; line-height: 1.5;"><%= (ai.assistant && ai.assistant.system_instruction) || '' %></textarea>
            <small class="text-muted" style="font-size: 0.8rem;">
                Instruksi ini akan selalu disematkan pada setiap percakapan antara pengguna dan AI untuk menjamin kepatuhan non-diagnosis medis dan aturan presisi data.
            </small>
        </div>

        <div class="mb-3">
            <label for="assistant-fallback" class="form-label fw-semibold" style="font-size: 0.88rem;">Pesan Fallback (Ketika AI Mengalami Gangguan)</label>
            <textarea id="assistant-fallback" class="form-control" rows="2" style="border-radius: 8px; font-size: 0.88rem;"><%= (ai.assistant && ai.assistant.fallback_message) || '' %></textarea>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- MODAL: UJI KONEKSI AI -->
<!-- ============================================================ -->
<div id="aiTestModal" class="modal-overlay" style="display: none;">
    <div class="modal-card" style="max-width: 520px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
                <span>⚡</span> Uji Koneksi Layanan AI
            </h3>
            <button type="button" onclick="closeAiTestModal()" style="background: none; border: none; font-size: 1.5rem; color: var(--text-muted); cursor: pointer; line-height: 1;">&times;</button>
        </div>
        <div>
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px; color: var(--text-main);">Pilih Provider yang Ingin Diuji:</label>
                <select id="modal-test-provider" class="form-control" onchange="onModalProviderChanged()" style="width: 100%; border-radius: 8px; padding: 9px 12px; font-size: 0.9rem;">
                    <option value="gemini">Google Gemini AI</option>
                    <option value="openai">OpenAI (ChatGPT)</option>
                    <option value="custom_ai">Custom AI (Groq / DeepSeek / OpenRouter)</option>
                    <option value="claude">Anthropic Claude</option>
                    <option value="local_knowledge">SkinCheck Local Knowledge Engine</option>
                </select>
            </div>
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 6px; color: var(--text-main);">Model:</label>
                <select id="modal-test-model" class="form-control" style="width: 100%; border-radius: 8px; padding: 9px 12px; font-size: 0.9rem;">
                    <option value="gemini-3.5-flash-lite">gemini-3.5-flash-lite (Direkomendasikan)</option>
                    <option value="gemini-3.5-flash">gemini-3.5-flash</option>
                    <option value="gemini-3.8-flash">gemini-3.8-flash</option>
                </select>
            </div>

            <div id="test-result-box" class="d-none" style="padding: 14px; border-radius: 10px; font-size: 0.85rem; margin-bottom: 16px;">
                <!-- Result filled via JS -->
            </div>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; border-top: 1px solid var(--border-color); padding-top: 16px;">
            <button type="button" class="btn btn-secondary" onclick="closeAiTestModal()" style="padding: 9px 18px; border-radius: 8px;">Tutup</button>
            <button type="button" class="btn btn-primary" id="btn-run-ai-test" onclick="executeAiTest()" style="padding: 9px 22px; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px;">
                <span id="test-spinner" class="spinner-border spinner-border-sm d-none" style="width: 1rem; height: 1rem; border-width: 0.15em;" role="status"></span>
                <span>Mulai Uji Koneksi</span>
            </button>
        </div>
    </div>
</div>

<script>
let currentActiveAiProvider = "<%= ai.active_provider %>";

const PROVIDER_MODELS = {
    gemini: [
        { id: 'gemini-3.5-flash-lite', name: 'gemini-3.5-flash-lite (Direkomendasikan & Sangat Cepat)' },
        { id: 'gemini-3.5-flash', name: 'gemini-3.5-flash (Multimodal & Cerdas)' },
        { id: 'gemini-3.8-flash', name: 'gemini-3.8-flash (Flagship Model)' }
    ],
    openai: [
        { id: 'gpt-4o-mini', name: 'gpt-4o-mini (Cepat & Ekonomis)' },
        { id: 'gpt-4o', name: 'gpt-4o (Flagship Model)' }
    ],
    custom_ai: [
        { id: 'llama-3.3-70b-versatile', name: 'llama-3.3-70b-versatile (Groq)' },
        { id: 'deepseek-chat', name: 'deepseek-chat (DeepSeek V3)' }
    ],
    claude: [
        { id: 'claude-3-5-haiku-20241022', name: 'claude-3-5-haiku-20241022 (Super Cepat)' },
        { id: 'claude-3-5-sonnet-20241022', name: 'claude-3-5-sonnet-20241022' }
    ],
    local_knowledge: [
        { id: 'local-knowledge-v1', name: 'local-knowledge-v1 (Offline DB Engine)' }
    ]
};

function onModalProviderChanged() {
    const prov = document.getElementById('modal-test-provider').value;
    const modelSelect = document.getElementById('modal-test-model');
    modelSelect.innerHTML = '';
    const models = PROVIDER_MODELS[prov] || [];
    models.forEach(m => {
        const opt = document.createElement('option');
        opt.value = m.id;
        opt.textContent = m.name;
        modelSelect.appendChild(opt);
    });
}

function switchAiTab(tabName) {
    document.querySelectorAll('.ai-tab-content').forEach(el => el.classList.add('d-none'));
    document.querySelectorAll('#aiConfigTabs .nav-link').forEach(el => {
        el.classList.remove('active');
        el.classList.add('text-muted');
    });

    if (tabName === 'provider') {
        document.getElementById('ai-section-provider').classList.remove('d-none');
        document.getElementById('tab-provider-btn').classList.add('active');
        document.getElementById('tab-provider-btn').classList.remove('text-muted');
    } else if (tabName === 'models') {
        document.getElementById('ai-section-models').classList.remove('d-none');
        document.getElementById('tab-models-btn').classList.add('active');
        document.getElementById('tab-models-btn').classList.remove('text-muted');
    } else if (tabName === 'assistant') {
        document.getElementById('ai-section-assistant').classList.remove('d-none');
        document.getElementById('tab-assistant-btn').classList.add('active');
        document.getElementById('tab-assistant-btn').classList.remove('text-muted');
    }
}

function setActiveAiProvider(providerName) {
    currentActiveAiProvider = providerName;
    saveAllAiConfig();
}

function onDefaultModelChanged(modelId) {
    // Handled on save
}

function showAiAlert(msg, type = 'success') {
    const alertBox = document.getElementById('ai-alert');
    alertBox.className = `alert alert-${type} mb-4 py-3 px-4 rounded-3`;
    alertBox.innerHTML = msg;
    alertBox.classList.remove('d-none');
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

async function saveAllAiConfig() {
    const btn = document.getElementById('btn-save-ai');
    const spinner = document.getElementById('save-spinner');
    const btnText = document.getElementById('save-btn-text');

    btn.disabled = true;
    spinner.classList.remove('d-none');
    btnText.textContent = 'Menyimpan...';

    // Gather models
    const selectedDefaultRadio = document.querySelector('input[name="default_model_radio"]:checked');
    const defaultModelId = selectedDefaultRadio ? selectedDefaultRadio.value : 'gemini-3.5-flash-lite';

    const modelRows = document.querySelectorAll('#models-table-body tr');
    const modelsPayload = [];

    modelRows.forEach(row => {
        const id = row.getAttribute('data-model-id');
        const provider = row.getAttribute('data-model-provider');
        const name = row.getAttribute('data-model-name') || row.querySelector('strong')?.textContent?.trim() || id;
        const description = row.getAttribute('data-model-desc') || '';
        const maxTokens = row.querySelector('.model-max-tokens').value;
        const temperature = row.querySelector('.model-temperature').value;
        const timeout = row.querySelector('.model-timeout').value;
        const retry = row.querySelector('.model-retry').value;
        const isActive = row.querySelector('.model-active-switch').checked;

        modelsPayload.push({
            id,
            name,
            provider,
            description,
            max_tokens: parseInt(maxTokens) || 1000,
            temperature: parseFloat(temperature) || 0.7,
            timeout_ms: parseInt(timeout) || 10000,
            retry_count: parseInt(retry) || 1,
            is_active: isActive,
            is_default: (id === defaultModelId)
        });
    });

    const payload = {
        active_provider: currentActiveAiProvider,
        provider_settings: {
            gemini: {
                api_key: document.getElementById('gemini-api-key')?.value || '',
                default_model: (defaultModelId && defaultModelId.startsWith('gemini')) ? defaultModelId : 'gemini-3.5-flash-lite'
            },
            openai: {
                api_key: document.getElementById('openai-api-key')?.value || '',
                api_base_url: document.getElementById('openai-base-url')?.value || 'https://api.openai.com/v1',
                default_model: 'gpt-4o-mini'
            },
            custom_ai: {
                api_key: document.getElementById('custom-api-key')?.value || '',
                api_base_url: document.getElementById('custom-base-url')?.value || 'https://api.groq.com/openai/v1',
                default_model: 'llama-3.3-70b-versatile'
            },
            claude: {
                api_key: document.getElementById('claude-api-key')?.value || '',
                api_base_url: document.getElementById('claude-base-url')?.value || 'https://api.anthropic.com/v1',
                default_model: 'claude-3-5-haiku-20241022'
            }
        },
        models: modelsPayload,
        assistant: {
            name: document.getElementById('assistant-name')?.value || 'SkinCheck AI Assistant',
            language: document.getElementById('assistant-lang')?.value || 'id',
            communication_style: document.getElementById('assistant-style')?.value || 'Ramah & Profesional',
            max_response_length: parseInt(document.getElementById('assistant-max-length')?.value) || 150,
            system_instruction: document.getElementById('assistant-instruction')?.value || '',
            fallback_message: document.getElementById('assistant-fallback')?.value || ''
        }
    };

    try {
        const res = await fetch('/admin/config/ai', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (data.success) {
            showAiAlert('<strong>Berhasil!</strong> ' + data.message, 'success');
            setTimeout(() => location.reload(), 1200);
        } else {
            showAiAlert('<strong>Gagal:</strong> ' + data.message, 'danger');
        }
    } catch (err) {
        showAiAlert('<strong>Kesalahan:</strong> ' + err.message, 'danger');
    } finally {
        btn.disabled = false;
        spinner.classList.add('d-none');
        btnText.textContent = '💾 Simpan Konfigurasi';
    }
}

function openAiTestModal(provider = 'gemini') {
    const provSelect = document.getElementById('modal-test-provider');
    if (provSelect) provSelect.value = provider;
    onModalProviderChanged();
    const resultBox = document.getElementById('test-result-box');
    if (resultBox) resultBox.classList.add('d-none');
    
    const modal = document.getElementById('aiTestModal');
    if (modal) modal.style.display = 'flex';
}

function closeAiTestModal() {
    const modal = document.getElementById('aiTestModal');
    if (modal) modal.style.display = 'none';
}

function testSpecificAi(provider) {
    openAiTestModal(provider);
}

// Close modal when clicking outside card
window.addEventListener('click', (e) => {
    const modal = document.getElementById('aiTestModal');
    if (e.target === modal) {
        closeAiTestModal();
    }
});

async function executeAiTest() {
    const provider = document.getElementById('modal-test-provider').value;
    const modelId = document.getElementById('modal-test-model').value;
    const resultBox = document.getElementById('test-result-box');
    const btn = document.getElementById('btn-run-ai-test');
    const spinner = document.getElementById('test-spinner');

    btn.disabled = true;
    spinner.classList.remove('d-none');
    resultBox.classList.add('d-none');

    try {
        const res = await fetch('/admin/config/ai/test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ provider, modelId })
        });
        const data = await res.json();

        resultBox.classList.remove('d-none');
        if (data.success) {
            resultBox.style.background = 'rgba(0, 184, 148, 0.12)';
            resultBox.style.border = '1px solid #00b894';
            resultBox.style.color = '#006241';
            resultBox.innerHTML = `
                <div class="fw-bold mb-1">✔ Koneksi Berhasil!</div>
                <div><strong>Provider:</strong> ${data.provider} | <strong>Model:</strong> ${data.model || '-'}</div>
                <div><strong>Latency:</strong> ${data.latencyMs} ms</div>
                <div><strong>Output Uji:</strong> <em>"${data.response || ''}"</em></div>
            `;
        } else {
            resultBox.style.background = 'rgba(214, 48, 49, 0.1)';
            resultBox.style.border = '1px solid #d63031';
            resultBox.style.color = '#d63031';
            resultBox.innerHTML = `
                <div class="fw-bold mb-1">✖ Pengujian Gagal</div>
                <div>${data.error || 'Terjadi kesalahan pada provider.'}</div>
                ${data.latencyMs ? `<div><strong>Waktu respons:</strong> ${data.latencyMs} ms</div>` : ''}
            `;
        }
    } catch (err) {
        resultBox.classList.remove('d-none');
        resultBox.style.background = 'rgba(214, 48, 49, 0.1)';
        resultBox.style.border = '1px solid #d63031';
        resultBox.style.color = '#d63031';
        resultBox.innerHTML = `<div class="fw-bold">Gagal menghubungi server: ${err.message}</div>`;
    } finally {
        btn.disabled = false;
        spinner.classList.add('d-none');
    }
}
</script>
