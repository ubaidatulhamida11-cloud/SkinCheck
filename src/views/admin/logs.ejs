<div style="margin-bottom: 25px;">
    <h1 style="font-size: 1.8rem; font-weight: 800; color: #1e293b; margin-bottom: 6px;">Log Aktivitas Sistem</h1>
    <p style="color: #64748b; margin: 0; font-size: 0.95rem;">Catatan aktivitas autentikasi, chat AI, dan event sistem aplikasi SkinCheck.</p>
</div>

<div style="background: #ffffff; border-radius: 14px; padding: 24px; border: 1px solid #e2e8f0;">
    <table class="data-table">
        <thead>
            <tr>
                <th>Waktu</th>
                <th>Tipe Event</th>
                <th>Keterangan</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td style="color: #64748b; font-size: 0.85rem;"><%= new Date().toLocaleDateString('id-ID', { hour: '2-digit', minute: '2-digit' }) %></td>
                <td><span style="font-weight: 600; color: #6C5CE7;">AUTH_SYSTEM</span></td>
                <td>Autentikasi sesi administrator aktif</td>
                <td><span class="badge-status-active">● Success</span></td>
            </tr>
            <tr>
                <td style="color: #64748b; font-size: 0.85rem;"><%= new Date().toLocaleDateString('id-ID', { hour: '2-digit', minute: '2-digit' }) %></td>
                <td><span style="font-weight: 600; color: #00cec9;">AI_CHATBOT</span></td>
                <td>Chatbot membaca statistik database pengguna secara real-time</td>
                <td><span class="badge-status-active">● Success</span></td>
            </tr>
        </tbody>
    </table>
</div>
