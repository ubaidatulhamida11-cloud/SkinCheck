<div style="margin-bottom: 25px;">
    <h1 style="font-size: 1.8rem; font-weight: 800; color: #1e293b; margin-bottom: 6px;">Ringkasan Admin Dashboard</h1>
    <p style="color: #64748b; margin: 0; font-size: 0.95rem;">Pantau metrik pengguna, katalog produk, dan status sistem SkinCheck secara langsung.</p>
</div>

<!-- Stat Cards Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
    <div class="stat-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Total Pengguna</span>
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(108, 92, 231, 0.1); color: #6C5CE7; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">👥</div>
        </div>
        <div style="font-size: 2rem; font-weight: 800; color: #1e293b; line-height: 1;"><%= locals.stats ? stats.total : 0 %></div>
        <div style="font-size: 0.82rem; color: #00b894; margin-top: 8px; font-weight: 600;"><%= locals.stats ? stats.active : 0 %> akun aktif di database</div>
    </div>

    <div class="stat-card" style="cursor: pointer;" onclick="window.location.href='/admin/users?role=admin'">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Pengguna Admin</span>
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(225, 112, 85, 0.1); color: #d63031; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">🛡️</div>
        </div>
        <div style="font-size: 2rem; font-weight: 800; color: #1e293b; line-height: 1;"><%= locals.stats && stats.roles ? (stats.roles['admin'] || 0) : 0 %></div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
            <span style="font-size: 0.82rem; color: #64748b;">Akses administrator</span>
            <a href="/admin/users?role=admin" style="font-size: 0.78rem; font-weight: 700; color: #d63031; text-decoration: none;">Filter &rarr;</a>
        </div>
    </div>

    <div class="stat-card" style="cursor: pointer;" onclick="window.location.href='/admin/users?role=customer'">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Customer Terdaftar</span>
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(0, 206, 201, 0.1); color: #00cec9; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">👤</div>
        </div>
        <div style="font-size: 2rem; font-weight: 800; color: #1e293b; line-height: 1;"><%= locals.stats && stats.roles ? (stats.roles['customer'] || 0) : 0 %></div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
            <span style="font-size: 0.82rem; color: #64748b;">Pengguna aktif aplikasi</span>
            <a href="/admin/users?role=customer" style="font-size: 0.78rem; font-weight: 700; color: #00cec9; text-decoration: none;">Filter &rarr;</a>
        </div>
    </div>

    <div class="stat-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Katalog Produk</span>
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(253, 121, 168, 0.1); color: #fd79a8; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">🛍️</div>
        </div>
        <div style="font-size: 2rem; font-weight: 800; color: #1e293b; line-height: 1;"><%= locals.products ? products.length : 0 %></div>
        <div style="font-size: 0.82rem; color: #64748b; margin-top: 8px;">Rekomendasi AI terhubung</div>
    </div>

    <div class="stat-card" style="cursor: pointer;" onclick="window.location.href='/admin/chat-history'">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
            <span style="font-size: 0.85rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Interaksi Chatbot</span>
            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(108, 92, 231, 0.12); color: #6c5ce7; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">🤖</div>
        </div>
        <div style="font-size: 2rem; font-weight: 800; color: #1e293b; line-height: 1;"><%= locals.recentCustomerChats ? recentCustomerChats.length : 0 %></div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
            <span style="font-size: 0.82rem; color: #64748b;"><%= locals.totalChatMessages ? totalChatMessages : 0 %> pesan</span>
            <a href="/admin/chat-history" style="font-size: 0.78rem; font-weight: 700; color: #6c5ce7; text-decoration: none;">Lihat History &rarr;</a>
        </div>
    </div>
</div>

<!-- Registered Users Section with Filter -->
<div style="background: #ffffff; border-radius: 14px; padding: 24px; border: 1px solid #e2e8f0; margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
        <div>
            <h2 style="font-size: 1.2rem; font-weight: 700; color: #1e293b; margin: 0;">Daftar Pengguna Sistem</h2>
            <p style="font-size: 0.85rem; color: #64748b; margin: 4px 0 0 0;">Semua akun pengguna yang tercatat dalam basis data SkinCheck.</p>
        </div>
        <div style="display: flex; align-items: center; gap: 8px;">
            <div class="btn-group btn-group-sm" role="group" aria-label="Filter role dashboard">
                <button type="button" class="btn btn-outline-secondary active fw-bold" id="dash-btn-all" onclick="filterDashboardUsers('all')">Semua</button>
                <button type="button" class="btn btn-outline-danger fw-bold" id="dash-btn-admin" onclick="filterDashboardUsers('admin')">🛡️ Admin</button>
                <button type="button" class="btn btn-outline-primary fw-bold" id="dash-btn-customer" onclick="filterDashboardUsers('customer')">👤 Customer</button>
            </div>
            <a href="/admin/users" class="btn btn-secondary btn-sm" style="font-size: 0.85rem; padding: 6px 14px;">Kelola Semua &rarr;</a>
        </div>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Nama Pengguna</th>
                <th>Email</th>
                <th>Peran (Role)</th>
                <th>Status</th>
                <th>Tanggal Terdaftar</th>
            </tr>
        </thead>
        <tbody>
            <% if (locals.users && users.length > 0) { %>
                <% users.forEach(u => { %>
                    <tr class="dash-user-row" data-role="<%= (u.role || 'customer').toLowerCase() %>">
                        <td style="font-weight: 600;">
                            <%= u.name %>
                        </td>
                        <td><%= u.email %></td>
                        <td>
                            <% if (u.role === 'admin') { %>
                                <span class="badge-role-admin">🛡️ Admin</span>
                            <% } else { %>
                                <span class="badge-role-customer">👤 Customer</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (u.status === 'active') { %>
                                <span class="badge-status-active">● Aktif</span>
                            <% } else { %>
                                <span style="background: #f1f5f9; color: #94a3b8; padding: 4px 10px; border-radius: 20px; font-size: 0.8rem; font-weight: 700;"><%= u.status %></span>
                            <% } %>
                        </td>
                        <td style="color: #64748b; font-size: 0.85rem;">
                            <%= u.created_at ? new Date(u.created_at).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) : '-' %>
                        </td>
                    </tr>
                <% }); %>
                <tr id="dash-empty-filter-row" style="display: none;">
                    <td colspan="5" style="text-align: center; color: #94a3b8; padding: 30px;">
                        Tidak ada pengguna dengan peran tersebut di daftar ringkasan.
                    </td>
                </tr>
            <% } else { %>
                <tr>
                    <td colspan="5" style="text-align: center; color: #94a3b8; padding: 30px;">Belum ada data pengguna.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Riwayat Chatbot Terakhir Customer Section -->
<div style="background: #ffffff; border-radius: 14px; padding: 24px; border: 1px solid #e2e8f0; margin-bottom: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.02);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
        <div>
            <h2 style="font-size: 1.2rem; font-weight: 700; color: #1e293b; margin: 0; display: flex; align-items: center; gap: 8px;">
                <span>💬</span> Riwayat Chatbot Terakhir Customer
            </h2>
            <p style="font-size: 0.85rem; color: #64748b; margin: 4px 0 0 0;">Percakapan dan konsultasi terbaru antara customer dengan SkinCheck AI.</p>
        </div>
        <div>
            <a href="/admin/chat-history" class="btn btn-primary btn-sm" style="font-size: 0.85rem; padding: 6px 16px; border-radius: 8px; font-weight: 600;">
                Kelola Semua Riwayat Chat &rarr;
            </a>
        </div>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Saluran</th>
                <th>Pertanyaan Terakhir</th>
                <th>Jawaban AI Terakhir</th>
                <th>Waktu Interaksi</th>
                <th style="text-align: center;">Aksi</th>
            </tr>
        </thead>
        <tbody>
            <% if (locals.recentCustomerChats && recentCustomerChats.length > 0) { %>
                <% recentCustomerChats.forEach(chat => { %>
                    <% 
                        const d = new Date(chat.updatedAt);
                        let timeFormatted = '-';
                        if (!isNaN(d.getTime())) {
                            timeFormatted = d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) + ', ' +
                                String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0') + ' WIB';
                        }
                        const isWidget = chat.contextType === 'widget' || !chat.contextType;
                    %>
                    <tr>
                        <td style="font-weight: 600;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="width: 30px; height: 30px; border-radius: 50%; background: linear-gradient(135deg, #6C5CE7, #00CEC9); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.75rem;">
                                    <%= chat.user.name ? chat.user.name.charAt(0).toUpperCase() : 'U' %>
                                </div>
                                <div>
                                    <div style="color: #1e293b;"><%= chat.user.name %></div>
                                    <div style="font-size: 0.75rem; color: #94a3b8;"><%= chat.user.email %></div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span style="background: <%= isWidget ? 'rgba(108, 92, 231, 0.12)' : 'rgba(0, 206, 201, 0.12)' %>; color: <%= isWidget ? '#6c5ce7' : '#00cec9' %>; font-size: 0.72rem; font-weight: 700; padding: 3px 8px; border-radius: 12px;">
                                <%= isWidget ? '💬 Widget' : '🤖 Asisten' %>
                            </span>
                        </td>
                        <td style="max-width: 250px;">
                            <div style="font-size: 0.85rem; font-weight: 600; color: #1e293b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                <%= chat.lastUserMessage ? chat.lastUserMessage.content : '-' %>
                            </div>
                        </td>
                        <td style="max-width: 280px;">
                            <div style="font-size: 0.82rem; color: #64748b; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                <%= chat.lastAiMessage ? chat.lastAiMessage.content : '-' %>
                            </div>
                        </td>
                        <td style="font-size: 0.82rem; color: #64748b; white-space: nowrap;">
                            <%= timeFormatted %>
                        </td>
                        <td style="text-align: center; white-space: nowrap;">
                            <a href="/admin/chat-history" class="btn btn-outline-primary btn-sm" style="font-size: 0.78rem; padding: 4px 10px; border-radius: 6px;">
                                👁️ Buka Chat
                            </a>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="6" style="text-align: center; color: #94a3b8; padding: 30px;">
                        Belum ada interaksi chat customer terbaru. Percakapan customer akan muncul di sini secara otomatis.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<script>
function filterDashboardUsers(role) {
    const rows = document.querySelectorAll('.dash-user-row');
    const emptyRow = document.getElementById('dash-empty-filter-row');
    let visible = 0;

    rows.forEach(r => {
        const rowRole = r.getAttribute('data-role');
        if (role === 'all' || rowRole === role) {
            r.style.display = '';
            visible++;
        } else {
            r.style.display = 'none';
        }
    });

    if (emptyRow) {
        emptyRow.style.display = (visible === 0) ? '' : 'none';
    }

    // Update active button state
    ['all', 'admin', 'customer'].forEach(r => {
        const btn = document.getElementById(`dash-btn-${r}`);
        if (btn) {
            if (r === role) {
                btn.classList.add('active');
            } else {
                btn.classList.remove('active');
            }
        }
    });
}
</script>
