                    <button type="button" class="theme-toggle-btn" title="Ganti Tema Gelap/Terang" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; padding: 6px 12px; border-radius: 8px; font-size: 0.82rem; font-weight: 600; cursor: pointer;">
                        🌙 <span>Gelap</span>
                    </button>
                    <a href="/app/dashboard" class="btn btn-secondary" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #334155; padding: 6px 14px; font-size: 0.82rem; border-radius: 8px; display: flex; align-items: center; gap: 6px; font-weight: 600; text-decoration: none;">
