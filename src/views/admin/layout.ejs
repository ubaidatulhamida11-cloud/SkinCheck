                            <%= locals.user ? locals.user.name.charAt(0).toUpperCase() : 'A' %>
                        </div>
                        <div style="line-height: 1.2;">
                            <div style="font-weight: 700; font-size: 0.85rem; color: #0f172a;"><%= locals.user ? locals.user.name : 'Administrator' %></div>
                            <div style="font-size: 0.72rem; color: #64748b;"><%= locals.user ? locals.user.email : 'admin@skincheck.local' %></div>
                        </div>
