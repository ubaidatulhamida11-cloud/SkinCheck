    <%- include('../partials/chatbot-widget') %>

    <script>
        (function() {
            const toggleBtn = document.getElementById('admin-sidebar-toggle');
            const closeBtn = document.getElementById('admin-sidebar-close-btn');
            const layoutRoot = document.getElementById('admin-app-layout');
            const sidebar = document.getElementById('admin-sidebar');
            const overlay = document.getElementById('admin-sidebar-overlay');

            function syncSidebarState(isCollapsed) {
                if (toggleBtn) {
                    toggleBtn.setAttribute('title', isCollapsed ? 'Tampilkan Menu (Alt+S)' : 'Sembunyikan Menu (Alt+S)');
                    toggleBtn.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
                    if (isCollapsed) {
                        toggleBtn.classList.add('active-collapsed');
                    } else {
                        toggleBtn.classList.remove('active-collapsed');
                    }
                }
            }

            // Determine initial state
            const isSavedCollapsed = localStorage.getItem('skincheck_admin_sidebar_collapsed') === '1';
            const isPreloadCollapsed = document.documentElement.classList.contains('preload-admin-sidebar-collapsed');

            if ((isPreloadCollapsed || (isSavedCollapsed && window.innerWidth > 992)) && layoutRoot) {
                layoutRoot.classList.add('sidebar-collapsed');
                syncSidebarState(true);
            } else {
                syncSidebarState(false);
            }

            function toggleSidebar() {
                if (window.innerWidth <= 992) {
                    // Mobile behavior: off-canvas drawer
                    if (sidebar) sidebar.classList.toggle('open');
                    if (overlay) overlay.classList.toggle('active');
                } else {
                    // Desktop behavior: collapse / expand
                    if (layoutRoot) {
                        layoutRoot.classList.toggle('sidebar-collapsed');
                        const isCollapsed = layoutRoot.classList.contains('sidebar-collapsed');
                        localStorage.setItem('skincheck_admin_sidebar_collapsed', isCollapsed ? '1' : '0');
                        syncSidebarState(isCollapsed);
                    }
                }
            }

            function closeSidebar() {
                if (window.innerWidth <= 992) {
                    if (sidebar) sidebar.classList.remove('open');
                    if (overlay) overlay.classList.remove('active');
                } else {
                    if (layoutRoot) {
                        layoutRoot.classList.add('sidebar-collapsed');
                        localStorage.setItem('skincheck_admin_sidebar_collapsed', '1');
                        syncSidebarState(true);
                    }
                }
            }

            if (toggleBtn) toggleBtn.addEventListener('click', toggleSidebar);
            if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
            if (overlay) overlay.addEventListener('click', () => {
                if (sidebar) sidebar.classList.remove('open');
                if (overlay) overlay.classList.remove('active');
            });

            // Keyboard shortcut Alt+S to toggle sidebar
            document.addEventListener('keydown', (e) => {
                if (e.altKey && (e.key === 's' || e.key === 'S')) {
                    e.preventDefault();
                    toggleSidebar();
                }
            });
        })();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmxc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
