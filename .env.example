# ==============================================================================
# SkinCheck - Environment Configuration Example
# Copy this file to .env and configure the variables for your environment.
# NEVER commit the actual .env file or real credentials to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
SESSION_SECRET=skincheck-mvp-super-secret

# ------------------------------------------------------------------------------
# WhatsApp Business Platform Configuration
# ------------------------------------------------------------------------------
# Provider selection:
# - 'meta'   : Meta WhatsApp Business Cloud API (graph.facebook.com)
# - 'fonnte' : Fonnte WhatsApp Gateway (api.fonnte.com - populer di Indonesia, hanya butuh 1 token)
# - 'mock'   : Mode simulasi offline (untuk automated test saja)
WHATSAPP_PROVIDER=meta

# ------------------------------------------------------------------------------
# Option A: Meta WhatsApp Business Cloud API Credentials (jika WHATSAPP_PROVIDER=meta)
# Dapatkan dari: Meta for Developers -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0

# ------------------------------------------------------------------------------
# Option B: Fonnte API Token (jika WHATSAPP_PROVIDER=fonnte)
# Dapatkan dari: https://md.fonnte.com/device -> menu Device Token
# Cukup isi WHATSAPP_ACCESS_TOKEN dengan token Fonnte Anda.
# ------------------------------------------------------------------------------

# Webhook Security (Required for receiving delivery receipts / incoming webhook events)
# Obtain or configure in Meta App Dashboard -> WhatsApp -> Configuration -> Webhook
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# WhatsApp Message Template Configuration
# Meta requires an approved template for business-initiated conversations outside the 24-hr window.
# Template type: Authentication
WHATSAPP_TEMPLATE_NAME=skincheck_verification
WHATSAPP_TEMPLATE_LANG=id

# ------------------------------------------------------------------------------
# OTP Security & Rate Limiting Configuration
# ------------------------------------------------------------------------------
# Secret key used for HMAC-SHA256 hashing of OTPs before storage (change in production)
OTP_SECRET_KEY=skincheck-otp-hmac-secret-key-change-in-prod

# Expiration time for generated OTP in seconds (default: 300s / 5 minutes)
OTP_EXPIRATION_SECONDS=300

# Minimum cooldown between OTP resend requests in seconds (default: 60s)
OTP_RESEND_COOLDOWN_SECONDS=60

# Maximum failed verification attempts allowed per OTP challenge (default: 5)
OTP_MAX_ATTEMPTS=5

# Rate limit window in minutes (default: 15 minutes)
OTP_RATE_LIMIT_WINDOW_MINUTES=15

# Maximum OTP requests allowed per phone number in window (default: 5)
OTP_RATE_LIMIT_MAX_PER_PHONE=5

# Maximum OTP requests allowed per IP address in window (default: 10)
OTP_RATE_LIMIT_MAX_PER_IP=10
